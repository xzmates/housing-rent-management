page {
  --primary: #3B82F6;
  --primary-light: #60A5FA;
  --primary-dark: #2563EB;
  --success: #10B981;
  --warning: #F59E0B;
  --danger: #EF4444;
  --gray-50: #F9FAFB;
  --gray-100: #F3F4F6;
  --gray-200: #E5E7EB;
  --gray-300: #D1D5DB;
  --gray-400: #9CA3AF;
  --gray-500: #6B7280;
  --gray-600: #4B5563;
  --gray-700: #374151;
  --gray-800: #1F2937;
  --gray-900: #111827;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --shadow-sm: 0 1rpx 3rpx rgba(0,0,0,0.06);
  --shadow-md: 0 4rpx 12rpx rgba(0,0,0,0.08);
  --shadow-lg: 0 8rpx 24rpx rgba(0,0,0,0.1);
  background-color: var(--gray-50);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--gray-900);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* ========== 通用容器 ========== */
.page-container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* ========== 卡片 ========== */
.card {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-900);
}

/* ========== 按钮 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0 40rpx;
}

.btn-primary {
  background: var(--primary);
  color: #FFFFFF;
}

.btn-primary:active {
  background: var(--primary-dark);
}

.btn-success {
  background: var(--success);
  color: #FFFFFF;
}

.btn-danger {
  background: var(--danger);
  color: #FFFFFF;
}

.btn-small {
  height: 56rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  border-radius: 28rpx;
}

.btn-block {
  width: 100%;
}

/* ========== 标签/徽章 ========== */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.badge-success {
  background: #D1FAE5;
  color: #065F46;
}

.badge-warning {
  background: #FEF3C7;
  color: #92400E;
}

.badge-danger {
  background: #FEE2E2;
  color: #991B1B;
}

.badge-info {
  background: #DBEAFE;
  color: #1E40AF;
}

.badge-gray {
  background: var(--gray-100);
  color: var(--gray-500);
}

/* ========== 表单 ========== */
.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--gray-700);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 76rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--gray-200);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  background: #FFFFFF;
  color: var(--gray-900);
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--primary);
}

.form-input::placeholder {
  color: var(--gray-400);
}

.form-picker {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--gray-200);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  background: #FFFFFF;
  color: var(--gray-900);
  box-sizing: border-box;
}

/* ========== 工具类 ========== */
.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 { flex: 1; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.justify-end { justify-content: flex-end; }
.align-center { align-items: center; }
.text-center { text-align: center; }
.text-right { text-align: right; }

/* ========== 加载/占位 ========== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--gray-400);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--gray-400);
  margin-bottom: 32rpx;
}

/* ========== 页面过渡 ========== */
/* 底部弹出模态框公共样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 32rpx;
  box-sizing: border-box;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* ========== 遮罩层 ========== */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 999;
}

/* ========== 统计卡片网格 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.stat-label {
  font-size: 22rpx;
  color: var(--gray-400);
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-value.blue { color: var(--primary); }
.stat-value.green { color: var(--success); }
.stat-value.yellow { color: var(--warning); }
.stat-value.red { color: var(--danger); }

/* ========== 筛选条 ========== */
.filter-bar {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.filter-btn {
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  background: #FFFFFF;
  color: var(--gray-500);
  border: 2rpx solid var(--gray-200);
}

.filter-btn.active {
  background: var(--primary);
  color: #FFFFFF;
  border-color: var(--primary);
}

/* ========== 列表项目 ========== */
.list-item {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.list-item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gray-900);
}

.list-item-sub {
  font-size: 24rpx;
  color: var(--gray-400);
  margin-top: 6rpx;
}

/* ========== 模态框动作按钮行 ========== */
.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-actions .btn {
  flex: 1;
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background: var(--gray-100);
  margin: 20rpx 0;
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom, 0);
}
