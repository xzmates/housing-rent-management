page {
  --primary: #2563EB;
  --primary-light: #3B82F6;
  --primary-dark: #1D4ED8;
  --primary-bg: #EFF6FF;
  --success: #059669;
  --success-light: #D1FAE5;
  --warning: #D97706;
  --warning-light: #FEF3C7;
  --danger: #DC2626;
  --danger-light: #FEE2E2;
  --gray-50: #F8FAFC;
  --gray-100: #F1F5F9;
  --gray-200: #E2E8F0;
  --gray-300: #CBD5E1;
  --gray-400: #94A3B8;
  --gray-500: #64748B;
  --gray-600: #475569;
  --gray-700: #334155;
  --gray-800: #1E293B;
  --gray-900: #0F172A;
  --radius-sm: 10rpx;
  --radius-md: 14rpx;
  --radius-lg: 20rpx;
  --radius-xl: 28rpx;
  --shadow-sm: 0 1rpx 2rpx rgba(15,23,42,0.04), 0 1rpx 4rpx rgba(15,23,42,0.03);
  --shadow-md: 0 2rpx 8rpx rgba(15,23,42,0.06), 0 1rpx 2rpx rgba(15,23,42,0.04);
  --shadow-lg: 0 4rpx 16rpx rgba(15,23,42,0.08), 0 2rpx 4rpx rgba(15,23,42,0.04);
  background-color: var(--gray-50);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--gray-900);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  line-height: 1.5;
}

/* ========== 通用容器 ========== */
.page-container {
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* ========== 卡片 ========== */
.card {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid var(--primary);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--gray-100);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gray-900);
  letter-spacing: 0.5rpx;
}

/* ========== 按钮 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 40rpx;
  letter-spacing: 1rpx;
}

.btn-primary {
  background: var(--primary);
  color: #FFFFFF;
}

.btn-primary:active {
  background: var(--primary-dark);
}

.btn-success {
  background: var(--success);
  color: #FFFFFF;
}

.btn-danger {
  background: var(--danger);
  color: #FFFFFF;
}

.btn-small {
  height: 56rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.btn-block {
  width: 100%;
}

/* ========== 标签/徽章 ========== */
.badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.badge-success {
  background: var(--success-light);
  color: #047857;
}

.badge-warning {
  background: var(--warning-light);
  color: #B45309;
}

.badge-danger {
  background: var(--danger-light);
  color: #B91C1C;
}

.badge-info {
  background: var(--primary-bg);
  color: var(--primary-dark);
}

.badge-gray {
  background: var(--gray-100);
  color: var(--gray-500);
}

/* ========== 表单 ========== */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gray-700);
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
}

.form-input {
  width: 100%;
  height: 76rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--gray-200);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  background: #FFFFFF;
  color: var(--gray-900);
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3rpx rgba(37,99,235,0.1);
}

.form-input::placeholder {
  color: var(--gray-400);
}

.form-picker {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--gray-200);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  background: #FFFFFF;
  color: var(--gray-900);
  box-sizing: border-box;
}

/* ========== 工具类 ========== */
.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 { flex: 1; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.justify-end { justify-content: flex-end; }
.align-center { align-items: center; }
.text-center { text-align: center; }
.text-right { text-align: right; }

/* ========== 加载/占位 ========== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--gray-400);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--gray-400);
  margin-bottom: 32rpx;
}

/* ========== 底部弹出模态框 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15,23,42,0.55);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  background: #FFFFFF;
  border-radius: 20rpx 20rpx 0 0;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 32rpx;
  box-sizing: border-box;
  animation: slideUp 0.3s cubic-bezier(0.16,1,0.3,1);
}

@keyframes slideUp {
  from { transform: translateY(100%); opacity: 0.8; }
  to { transform: translateY(0); opacity: 1; }
}

/* ========== 遮罩层 ========== */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15,23,42,0.45);
  z-index: 999;
}

/* ========== 统计卡片网格 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-sm);
  border-top: 4rpx solid var(--gray-200);
  position: relative;
  overflow: hidden;
}

.stat-card::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 0 0 0 64rpx;
  opacity: 0.06;
}

.stat-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--gray-500);
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
}

.stat-value {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
}

.stat-value.blue { color: var(--primary); }
.stat-value.green { color: var(--success); }
.stat-value.yellow { color: var(--warning); }
.stat-value.red { color: var(--danger); }

/* ========== 筛选条 ========== */
.filter-bar {
  display: flex;
  gap: 12rpx;
  flex-wrap: nowrap;
  margin-bottom: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-bottom: 4rpx;
}
.filter-bar::-webkit-scrollbar { display: none; }

.filter-btn {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: #FFFFFF;
  color: var(--gray-500);
  border: 2rpx solid var(--gray-200);
  letter-spacing: 0.5rpx;
}

.filter-btn.active {
  background: var(--gray-900);
  color: #FFFFFF;
  border-color: var(--gray-900);
}

/* ========== 列表项目 ========== */
.list-item {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid transparent;
}

.list-item-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gray-900);
}

.list-item-sub {
  font-size: 24rpx;
  color: var(--gray-400);
  margin-top: 6rpx;
}

/* ========== 模态框动作按钮行 ========== */
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--gray-100);
}

.modal-actions .btn {
  flex: 1;
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background: var(--gray-100);
  margin: 20rpx 0;
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom, 0);
}
