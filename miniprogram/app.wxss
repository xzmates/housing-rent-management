page {
  --primary: #2563EB;
  --primary-light: #3B82F6;
  --primary-dark: #1D4ED8;
  --primary-bg: #EFF6FF;
  --success: #059669;
  --success-light: #D1FAE5;
  --warning: #D97706;
  --warning-light: #FEF3C7;
  --danger: #DC2626;
  --danger-light: #FEE2E2;
  --gray-50: #F8FAFC;
  --gray-100: #F1F5F9;
  --gray-200: #E2E8F0;
  --gray-300: #CBD5E1;
  --gray-400: #94A3B8;
  --gray-500: #64748B;
  --gray-600: #475569;
  --gray-700: #334155;
  --gray-800: #1E293B;
  --gray-900: #0F172A;
  --radius-sm: 10rpx;
  --radius-md: 14rpx;
  --radius-lg: 20rpx;
  --radius-xl: 28rpx;
  --shadow-sm: 0 1rpx 2rpx rgba(15,23,42,0.04), 0 1rpx 4rpx rgba(15,23,42,0.03);
  --shadow-md: 0 2rpx 8rpx rgba(15,23,42,0.06), 0 1rpx 2rpx rgba(15,23,42,0.04);
  --shadow-lg: 0 4rpx 16rpx rgba(15,23,42,0.08), 0 2rpx 4rpx rgba(15,23,42,0.04);
  background-color: var(--gray-50);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--gray-900);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  line-height: 1.5;
}

/* ========== 通用容器 ========== */
.page-container {
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* ========== 卡片 ========== */
.card {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid var(--primary);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--gray-100);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gray-900);
  letter-spacing: 0;
}

/* ========== 按钮 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 40rpx;
  letter-spacing: 0;
}

.btn-primary {
  background: var(--primary);
  color: #FFFFFF;
}

.btn-primary:active {
  background: var(--primary-dark);
}

.btn-success {
  background: var(--success);
  color: #FFFFFF;
}

.btn-danger {
  background: var(--danger);
  color: #FFFFFF;
}

.btn-small {
  height: 56rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.btn-block {
  width: 100%;
}

/* ========== 标签/徽章 ========== */
.badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.badge-success {
  background: var(--success-light);
  color: #047857;
}

.badge-warning {
  background: var(--warning-light);
  color: #B45309;
}

.badge-danger {
  background: var(--danger-light);
  color: #B91C1C;
}

.badge-info {
  background: var(--primary-bg);
  color: var(--primary-dark);
}

.badge-gray {
  background: var(--gray-100);
  color: var(--gray-500);
}

/* ========== 表单 ========== */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gray-700);
  margin-bottom: 10rpx;
  letter-spacing: 0;
}

.form-input {
  width: 100%;
  height: 76rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--gray-200);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  background: #FFFFFF;
  color: var(--gray-900);
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3rpx rgba(37,99,235,0.1);
}

.form-input::placeholder {
  color: var(--gray-400);
}

.form-picker {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--gray-200);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  background: #FFFFFF;
  color: var(--gray-900);
  box-sizing: border-box;
}

/* ========== 工具类 ========== */
.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 { flex: 1; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.justify-end { justify-content: flex-end; }
.align-center { align-items: center; }
.text-center { text-align: center; }
.text-right { text-align: right; }

/* ========== 加载/占位 ========== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--gray-400);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--gray-400);
  margin-bottom: 32rpx;
}

/* ========== 底部弹出模态框 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15,23,42,0.55);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  background: #FFFFFF;
  border-radius: 20rpx 20rpx 0 0;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 32rpx;
  box-sizing: border-box;
  animation: slideUp 0.3s cubic-bezier(0.16,1,0.3,1);
}

@keyframes slideUp {
  from { transform: translateY(100%); opacity: 0.8; }
  to { transform: translateY(0); opacity: 1; }
}

/* ========== 遮罩层 ========== */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15,23,42,0.45);
  z-index: 999;
}

/* ========== 统计卡片网格 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-sm);
  border-top: 4rpx solid var(--gray-200);
  position: relative;
  overflow: hidden;
}

.stat-card::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 0 0 0 64rpx;
  opacity: 0.06;
}

.stat-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--gray-500);
  margin-bottom: 6rpx;
  letter-spacing: 0;
}

.stat-value {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.stat-value.blue { color: var(--primary); }
.stat-value.green { color: var(--success); }
.stat-value.yellow { color: var(--warning); }
.stat-value.red { color: var(--danger); }

/* ========== 筛选条 ========== */
.filter-bar {
  display: flex;
  gap: 12rpx;
  flex-wrap: nowrap;
  margin-bottom: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-bottom: 4rpx;
}
.filter-bar::-webkit-scrollbar { display: none; }

.filter-btn {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: #FFFFFF;
  color: var(--gray-500);
  border: 2rpx solid var(--gray-200);
  letter-spacing: 0;
}

.filter-btn.active {
  background: var(--gray-900);
  color: #FFFFFF;
  border-color: var(--gray-900);
}

/* ========== 列表项目 ========== */
.list-item {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid transparent;
}

.list-item-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gray-900);
}

.list-item-sub {
  font-size: 24rpx;
  color: var(--gray-400);
  margin-top: 6rpx;
}

/* ========== 模态框动作按钮行 ========== */
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--gray-100);
}

.modal-actions .btn {
  flex: 1;
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background: var(--gray-100);
  margin: 20rpx 0;
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom, 0);
}

/* ========== Apple Home 风格视觉层（一级页优先使用） ========== */
page {
  --home-blue: #1677FF;
  --home-blue-soft: #EAF3FF;
  --home-blue-deep: #0B5FD7;
  --home-ink: #111827;
  --home-text: #1F2937;
  --home-muted: #6B7280;
  --home-faint: #94A3B8;
  --home-line: rgba(148, 163, 184, 0.22);
  --home-glass: rgba(255, 255, 255, 0.84);
  --home-panel: rgba(255, 255, 255, 0.92);
  --home-bg: #EEF6FF;
  --home-green: #18A66A;
  --home-green-bg: #E9F8F1;
  --home-orange: #F59E2B;
  --home-orange-bg: #FFF4E5;
  --home-red: #EF5350;
  --home-red-bg: #FFEDED;
  --home-violet: #7C5CFF;
  --home-violet-bg: #F0EDFF;
  --home-radius-xl: 28rpx;
  --home-radius-lg: 24rpx;
  --home-radius-md: 20rpx;
  --home-shadow: 0 18rpx 48rpx rgba(30, 79, 140, 0.10), 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
  --home-shadow-soft: 0 10rpx 28rpx rgba(30, 79, 140, 0.08);
}

.home-page {
  min-height: 100vh;
  padding: 0 28rpx 44rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 78% 8%, rgba(22, 119, 255, 0.22), transparent 28%),
    linear-gradient(180deg, #DDEEFF 0%, #F7FBFF 34%, #F6F8FC 100%);
  color: var(--home-ink);
  overflow-x: hidden;
}

.home-hero {
  position: relative;
  min-height: 260rpx;
  padding: calc(env(safe-area-inset-top, 0) + 72rpx) 20rpx 34rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.home-hero::before {
  content: '';
  position: absolute;
  right: -34rpx;
  top: 54rpx;
  width: 330rpx;
  height: 230rpx;
  border-radius: 34rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.68);
  background: linear-gradient(135deg, rgba(255,255,255,0.56), rgba(91,157,255,0.16));
  transform: rotate(-10deg);
}

.home-hero::after {
  content: '';
  position: absolute;
  right: 18rpx;
  top: 136rpx;
  width: 188rpx;
  height: 116rpx;
  border-radius: 28rpx 28rpx 18rpx 18rpx;
  background: rgba(255,255,255,0.36);
  border: 2rpx solid rgba(255,255,255,0.72);
  transform: skewX(-12deg);
}

.home-hero-title {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 48rpx;
  line-height: 1.12;
  font-weight: 700;
  color: #111827;
  letter-spacing: 0;
}

.home-hero-subtitle {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--home-muted);
}

.home-hero-action {
  position: absolute;
  z-index: 2;
  right: 20rpx;
  bottom: 28rpx;
  min-width: 170rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #0F7CFF, #1263E6);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border: 0;
  box-shadow: 0 14rpx 28rpx rgba(18, 99, 230, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.hero-action-icon {
  width: 28rpx;
  height: 28rpx;
  position: relative;
  color: #FFFFFF;
  flex-shrink: 0;
}

.hero-action-icon::before,
.hero-action-icon::after {
  content: '';
  position: absolute;
  background: currentColor;
  border-radius: 4rpx;
}

.hero-action-icon::before {
  width: 26rpx;
  height: 4rpx;
  left: 1rpx;
  top: 12rpx;
}

.hero-action-icon::after {
  width: 4rpx;
  height: 26rpx;
  left: 12rpx;
  top: 1rpx;
}

.home-shell {
  position: relative;
  z-index: 3;
  margin-top: -10rpx;
  padding-bottom: env(safe-area-inset-bottom, 0);
}

.glass-panel,
.glass-card {
  background: var(--home-panel);
  border: 1rpx solid rgba(255,255,255,0.82);
  box-shadow: var(--home-shadow);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.glass-panel {
  border-radius: var(--home-radius-xl);
  padding: 28rpx;
  margin-bottom: 28rpx;
}

.glass-card {
  border-radius: var(--home-radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
  color: var(--home-ink);
}

.section-note {
  display: block;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--home-muted);
}

.soft-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  background: rgba(241, 245, 249, 0.88);
  color: var(--home-muted);
  font-size: 27rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255,255,255,0.72);
}

.soft-chip.active {
  color: var(--home-blue);
  background: #E7F1FF;
  font-weight: 700;
}

.soft-search {
  min-height: 66rpx;
  border-radius: 34rpx;
  padding: 0 24rpx;
  background: rgba(248, 250, 252, 0.92);
  border: 1rpx solid var(--home-line);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.home-filter-row {
  display: flex;
  gap: 18rpx;
  align-items: center;
  margin-bottom: 24rpx;
}

.filter-chip-group {
  display: flex;
  gap: 14rpx;
  flex-shrink: 0;
}

.home-search-input {
  flex: 1;
  height: 66rpx;
  font-size: 27rpx;
  color: var(--home-ink);
}

.home-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.search-mark {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #9AA7B8;
  border-radius: 50%;
  position: relative;
  box-sizing: border-box;
}

.search-mark::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  width: 14rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #9AA7B8;
  transform: rotate(45deg);
}

.line-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: block;
  position: relative;
  flex-shrink: 0;
  font-size: 0;
  background: var(--home-blue-soft);
  color: var(--home-blue);
}

.quick-icon,
.empty-line-icon,
.mini-house-icon {
  position: relative;
  font-size: 0;
}

.line-icon::before,
.line-icon::after,
.quick-icon::before,
.quick-icon::after,
.empty-line-icon::before,
.empty-line-icon::after,
.mini-house-icon::before,
.mini-house-icon::after {
  content: '';
  position: absolute;
  box-sizing: border-box;
}

.symbol-home::before {
  width: 26rpx;
  height: 22rpx;
  left: 15rpx;
  top: 25rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 2rpx 2rpx 6rpx 6rpx;
}

.symbol-home::after {
  width: 28rpx;
  height: 28rpx;
  left: 14rpx;
  top: 12rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: rotate(45deg);
  border-radius: 4rpx 0 0 0;
}

.symbol-contract::before {
  width: 26rpx;
  height: 34rpx;
  left: 15rpx;
  top: 11rpx;
  border: 4rpx solid currentColor;
  border-radius: 6rpx;
}

.symbol-contract::after {
  width: 16rpx;
  height: 4rpx;
  left: 21rpx;
  top: 24rpx;
  border-radius: 4rpx;
  background: currentColor;
  box-shadow: 0 10rpx 0 currentColor;
}

.symbol-money::before {
  width: 28rpx;
  height: 28rpx;
  left: 14rpx;
  top: 14rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.symbol-money::after {
  width: 4rpx;
  height: 28rpx;
  left: 26rpx;
  top: 14rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.symbol-shield::before {
  width: 30rpx;
  height: 34rpx;
  left: 13rpx;
  top: 11rpx;
  border: 4rpx solid currentColor;
  border-radius: 14rpx 14rpx 18rpx 18rpx;
}

.symbol-shield::after {
  width: 12rpx;
  height: 7rpx;
  left: 22rpx;
  top: 24rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(-45deg);
}

.symbol-plus::before,
.symbol-plus::after {
  background: currentColor;
  border-radius: 4rpx;
}

.symbol-plus::before {
  width: 30rpx;
  height: 4rpx;
  left: 20rpx;
  top: 33rpx;
}

.symbol-plus::after {
  width: 4rpx;
  height: 30rpx;
  left: 33rpx;
  top: 20rpx;
}

.line-icon.symbol-plus::before { left: 13rpx; top: 26rpx; }
.line-icon.symbol-plus::after { left: 26rpx; top: 13rpx; }

.mini-house-icon.symbol-home::before {
  width: 22rpx;
  height: 18rpx;
  left: 12rpx;
  top: 21rpx;
  border-width: 3rpx;
}

.mini-house-icon.symbol-home::after {
  width: 22rpx;
  height: 22rpx;
  left: 12rpx;
  top: 10rpx;
  border-left-width: 3rpx;
  border-top-width: 3rpx;
}

.quick-icon.symbol-money::before {
  left: 21rpx;
  top: 21rpx;
}

.quick-icon.symbol-money::after {
  left: 33rpx;
  top: 21rpx;
}

.symbol-upload::before {
  width: 28rpx;
  height: 22rpx;
  left: 21rpx;
  top: 34rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 8rpx 8rpx;
}

.symbol-upload::after {
  width: 20rpx;
  height: 20rpx;
  left: 25rpx;
  top: 17rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.symbol-meter::before {
  width: 34rpx;
  height: 34rpx;
  left: 18rpx;
  top: 18rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.symbol-meter::after {
  width: 18rpx;
  height: 4rpx;
  left: 34rpx;
  top: 35rpx;
  border-radius: 4rpx;
  background: currentColor;
  transform-origin: 0 50%;
  transform: rotate(-38deg);
}

.symbol-wave::before {
  width: 34rpx;
  height: 14rpx;
  left: 11rpx;
  top: 24rpx;
  border-bottom: 4rpx solid currentColor;
  border-radius: 50%;
}

.symbol-user::before {
  width: 22rpx;
  height: 22rpx;
  left: 17rpx;
  top: 11rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.symbol-user::after {
  width: 34rpx;
  height: 20rpx;
  left: 11rpx;
  top: 34rpx;
  border: 4rpx solid currentColor;
  border-radius: 20rpx 20rpx 8rpx 8rpx;
  border-bottom: 0;
}

.symbol-arrow::before,
.chevron::before {
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.chevron {
  width: 28rpx;
  height: 28rpx;
  color: #9AA7B8;
  position: relative;
  flex-shrink: 0;
}

.chevron::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 6rpx;
  box-sizing: border-box;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 72rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.status-blue { background: var(--home-blue-soft); color: var(--home-blue); }
.status-green { background: var(--home-green-bg); color: var(--home-green); }
.status-orange { background: var(--home-orange-bg); color: #C96D13; }
.status-red { background: var(--home-red-bg); color: #D94542; }
.status-gray { background: #EEF2F7; color: #657386; }

.primary-pill {
  height: 70rpx;
  padding: 0 36rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #0F7CFF, #4C9AFF);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  border: 0;
  margin: 0;
  line-height: 70rpx;
  box-shadow: 0 12rpx 26rpx rgba(22,119,255,0.22);
}

.ghost-pill {
  height: 62rpx;
  padding: 0 26rpx;
  border-radius: 32rpx;
  background: rgba(241, 245, 249, 0.88);
  color: var(--home-muted);
  font-size: 26rpx;
  font-weight: 600;
  border: 0;
  margin: 0;
  line-height: 62rpx;
}

.danger-text {
  color: #D94542;
}

.tap-card:active,
.primary-pill:active,
.ghost-pill:active {
  transform: scale(0.985);
  opacity: 0.86;
}

@media (max-width: 360px) {
  .home-filter-row {
    flex-direction: column;
    align-items: stretch;
  }

  .filter-chip-group {
    flex-wrap: wrap;
  }
}
