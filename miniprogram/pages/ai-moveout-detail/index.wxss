.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 36rpx;
  background: #F6FAFF;
}

.detail-content {
  display: flex;
  flex-direction: column;
}

.header-row {
  padding: 8rpx 0 28rpx;
}

.page-title {
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #111827;
}

.notice-box,
.ok-box,
.warning-box,
.settlement-box,
.rent-refund-box,
.final-box,
.empty-box {
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.notice-box {
  background: #FFFBEB;
  color: #92400E;
  font-size: 30rpx;
  line-height: 1.4;
}

.notice-strong {
  font-weight: 700;
}

.form-block {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #334155;
}

.form-picker,
.form-input {
  height: 86rpx;
  line-height: 86rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid #DFE7F2;
  background: #FFFFFF;
  font-size: 32rpx;
  color: #111827;
  box-sizing: border-box;
}

.form-input {
  width: 100%;
}

.error-box {
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #FEF2F2;
  color: #991B1B;
  font-size: 28rpx;
  line-height: 1.4;
}

.result-box {
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.4;
}

.result-box.success {
  background: #ECFDF5;
  color: #047857;
}

.result-box.failed {
  background: #FEF2F2;
  color: #991B1B;
}

.ok-box {
  background: #ECFDF5;
  color: #047857;
  font-size: 30rpx;
  line-height: 1.4;
}

.warning-box {
  background: #FEF2F2;
  color: #991B1B;
  font-size: 30rpx;
  line-height: 1.4;
}

.settlement-box {
  background: #F8FAFC;
}

.rent-refund-box {
  background: #F0FDF4;
}

.final-box {
  background: #EFF6FF;
}

.section-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1F2937;
}

.line-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 10rpx 0;
  font-size: 29rpx;
  line-height: 1.35;
  color: #64748B;
}

.line-row text:last-child {
  color: #111827;
  font-weight: 600;
  text-align: right;
}

.damage-box {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #FEF2F2;
}

.damage-title,
.damage-title text,
.danger-line,
.danger-line text,
.danger-text {
  color: #991B1B;
  font-weight: 700;
}

.sub-line {
  font-size: 26rpx;
}

.green-line,
.green-line text,
.green-text {
  color: #047857;
}

.detail-line,
.paid-rent-row,
.refund-total {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: #64748B;
}

.paid-rent-row {
  padding-left: 16rpx;
}

.refund-total {
  color: #047857;
  font-weight: 700;
}

.total-row {
  margin-top: 12rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #BFDBFE;
}

.total-row text {
  font-size: 34rpx;
  font-weight: 800;
}

.bottom-actions {
  padding-top: 8rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.confirm-btn {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 14rpx;
  background: #EA580C;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.confirm-btn.is-disabled {
  background: #CBD5E1;
  color: #FFFFFF;
}

.empty-box {
  margin-top: 180rpx;
  background: #FFFFFF;
  color: #64748B;
  font-size: 30rpx;
  line-height: 1.4;
}
