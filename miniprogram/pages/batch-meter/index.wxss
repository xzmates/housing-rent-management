/* batch-meter specific styles */
.meter-date-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.meter-date-label {
  font-size: 26rpx;
  color: var(--gray-700);
  font-weight: 600;
}

.meter-date-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
}

.meter-date-hint {
  color: var(--gray-400);
  font-size: 22rpx;
  font-weight: 400;
}
