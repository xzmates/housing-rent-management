<view class="page-container">
  <view style="margin-bottom:20rpx;">
    <navigator open-type="navigateBack" style="font-size:26rpx;color:var(--primary);">返回</navigator>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text class="loading-text">加载合同数据中...</text>
  </view>

  <block wx:elif="{{mode === 'list'}}">
    <view class="card" style="border-left-color:var(--primary);">
      <view class="flex-row justify-between align-center" style="gap:20rpx;">
        <view style="flex:1;min-width:0;">
          <text class="card-title" style="display:block;">历史纸质合同建档</text>
          <text style="font-size:23rpx;color:var(--gray-500);display:block;margin-top:8rpx;line-height:1.6;">拍照识别后人工绑定房屋、核对租客和已缴日期，不会生成历史收款流水。</text>
        </view>
        <button class="btn btn-primary btn-small" bindtap="goToHistoricalImport">拍照导入</button>
      </view>
    </view>

    <view class="card">
      <view class="card-header">
        <text class="card-title">合同查询</text>
      </view>

      <view class="flex-row" style="gap:16rpx;margin-bottom:20rpx;">
        <view style="flex:1;">
          <text class="form-label">年份范围</text>
          <picker mode="selector" range="{{periodOptions}}" value="{{periodIndex}}" bindchange="onPeriodChange">
            <view class="form-input">{{periodOptions[periodIndex]}}</view>
          </picker>
        </view>
        <view style="flex:1;">
          <text class="form-label">合同状态</text>
          <picker mode="selector" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatusChange">
            <view class="form-input">{{statusOptions[statusIndex]}}</view>
          </picker>
        </view>
      </view>

      <view wx:if="{{periodIndex === 3}}" class="form-group">
        <text class="form-label">指定年份</text>
        <input class="form-input" type="number" placeholder="例如 2025" value="{{yearInput}}" bindinput="onYearInput" />
      </view>

      <view class="stats-grid">
        <view class="stat-card" style="background:#EFF6FF;border:2rpx solid #BFDBFE;">
          <view class="stat-label">合同数</view>
          <view class="stat-value blue">{{stats.count}}</view>
        </view>
        <view class="stat-card" style="background:#F0FDF4;border:2rpx solid #BBF7D0;">
          <view class="stat-label">实收合计</view>
          <view class="stat-value green">￥{{stats.paymentIncome}}</view>
        </view>
        <view class="stat-card" style="background:#FFF7ED;border:2rpx solid #FED7AA;">
          <view class="stat-label">租金实收</view>
          <view class="stat-value orange">￥{{stats.rentIncome}}</view>
        </view>
        <view class="stat-card" style="background:#ECFDF5;border:2rpx solid #A7F3D0;">
          <view class="stat-label">水电费实收</view>
          <view class="stat-value green">￥{{stats.utilityIncome}}</view>
        </view>
        <view class="stat-card" style="background:#FFF7ED;border:2rpx solid #FDBA74;">
          <view class="stat-label">损失费实收</view>
          <view class="stat-value orange">￥{{stats.lossIncome}}</view>
        </view>
        <view class="stat-card" style="background:#FEF2F2;border:2rpx solid #FECACA;">
          <view class="stat-label">账单欠款</view>
          <view class="stat-value red">￥{{stats.billOutstanding}}</view>
        </view>
      </view>

      <text style="font-size:22rpx;color:var(--gray-400);display:block;margin-top:16rpx;">
        实收合计=租金实收+水电费实收+损失费实收；押金收退单独作为在管押金/退款流水查看。
      </text>
    </view>

    <view wx:if="{{filteredLeases.length === 0}}" class="empty-state">
      <text class="empty-text">暂无符合条件的合同</text>
    </view>

    <view wx:for="{{filteredLeases}}" wx:key="_id" class="list-item" bindtap="viewContract" data-id="{{item._id}}" style="border-left-color:{{item.status === 'active' ? 'var(--success)' : 'var(--gray-300)'}};">
      <view class="flex-row justify-between align-start">
        <view style="flex:1;min-width:0;">
          <view class="flex-row align-center" style="gap:12rpx;margin-bottom:8rpx;">
            <text style="font-size:30rpx;font-weight:600;color:var(--gray-900);">{{item.houseCode || '未命名房屋'}}</text>
            <text class="badge {{item.status === 'active' ? 'badge-success' : 'badge-info'}}">{{item.statusText}}</text>
          </view>
          <text style="font-size:24rpx;color:var(--gray-500);display:block;">{{item.tenantName || '未知租客'}} · {{item.houseAddress}}</text>
          <text style="font-size:22rpx;color:var(--gray-400);display:block;margin-top:6rpx;">{{item.startDateText}} 至 {{item.endDateText}} · {{item.paymentCycleText}}</text>
          <text wx:if="{{item.documentPeriodText}}" style="font-size:22rpx;color:#B45309;display:block;margin-top:6rpx;">纸面合同：{{item.documentPeriodText}} · {{item.occupancyText}}</text>
        </view>
        <view style="text-align:right;">
          <text style="font-size:28rpx;font-weight:700;color:var(--success);display:block;">￥{{item.paymentIncome}}</text>
          <text style="font-size:22rpx;color:var(--gray-400);">实收</text>
        </view>
      </view>

      <view class="flex-row" style="gap:12rpx;margin-top:16rpx;flex-wrap:wrap;">
        <text class="badge badge-info">租金 ￥{{item.rentIncome}}</text>
        <text class="badge badge-info">水电 ￥{{item.utilityIncome}}</text>
        <text wx:if="{{item.lossIncome > 0}}" class="badge badge-info">损失费 ￥{{item.lossIncome}}</text>
        <text wx:if="{{item.refundAmount > 0}}" class="badge badge-danger">退款 ￥{{item.refundAmount}}</text>
        <text class="badge badge-info">账单 {{item.billCount}} 条</text>
        <text wx:if="{{item.billOutstanding > 0}}" class="badge badge-danger">欠 ￥{{item.billOutstanding}}</text>
      </view>
      <view class="contract-actions">
        <button class="delete-button" size="mini" catchtap="deleteContract" data-id="{{item._id}}" loading="{{deleting}}">删除合同</button>
      </view>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{!contract}}" class="empty-state">
      <text class="empty-text">未找到合同信息</text>
    </view>

    <view wx:else class="card">
      <view class="text-center" style="margin-bottom:32rpx;">
        <text style="font-size:38rpx;font-weight:700;color:var(--gray-900);display:block;margin-bottom:8rpx;">房屋租赁合同</text>
        <text style="font-size:24rpx;color:var(--gray-400);display:block;">合同编号: {{contract.contractNo}}</text>
        <text class="badge badge-info" style="margin-top:12rpx;">{{contract.statusText}}</text>
      </view>

      <view class="stats-grid" style="margin-bottom:28rpx;">
        <view class="stat-card" style="background:#F0FDF4;border:2rpx solid #BBF7D0;">
          <view class="stat-label">实收合计</view>
          <view class="stat-value green">￥{{contract.paymentIncome}}</view>
        </view>
        <view class="stat-card" style="background:#EFF6FF;border:2rpx solid #BFDBFE;">
          <view class="stat-label">租金实收</view>
          <view class="stat-value blue">￥{{contract.rentIncome}}</view>
        </view>
        <view class="stat-card" style="background:#ECFDF5;border:2rpx solid #A7F3D0;">
          <view class="stat-label">水电费实收</view>
          <view class="stat-value green">￥{{contract.utilityIncome}}</view>
        </view>
        <view class="stat-card" style="background:#FFF7ED;border:2rpx solid #FDBA74;">
          <view class="stat-label">损失费实收</view>
          <view class="stat-value orange">￥{{contract.lossIncome}}</view>
        </view>
        <view class="stat-card" style="background:#FFF7ED;border:2rpx solid #FED7AA;">
          <view class="stat-label">账单数</view>
          <view class="stat-value orange">{{contract.billCount}}</view>
        </view>
        <view class="stat-card" style="background:#FEF2F2;border:2rpx solid #FECACA;">
          <view class="stat-label">退款流水</view>
          <view class="stat-value red">￥{{contract.refundAmount}}</view>
        </view>
      </view>

      <view style="margin-bottom:32rpx;">
        <text class="section-title">合同双方</text>
        <view style="background:#F8FAFC;border-radius:8rpx;padding:18rpx;">
          <text style="font-size:26rpx;display:block;margin-bottom:8rpx;">租客：{{contract.tenant.name}}</text>
          <text style="font-size:24rpx;color:var(--gray-500);display:block;margin-bottom:8rpx;">电话：{{contract.tenant.phone}}</text>
          <text style="font-size:24rpx;color:var(--gray-500);display:block;">身份证：{{contract.tenant.idCard}}</text>
        </view>
      </view>

      <view style="margin-bottom:32rpx;">
        <text class="section-title">房屋与租期</text>
        <view style="background:#F8FAFC;border-radius:8rpx;padding:18rpx;">
          <text style="font-size:26rpx;display:block;margin-bottom:8rpx;">{{contract.houseCode}} · {{contract.houseAddress}}</text>
          <text style="font-size:24rpx;color:var(--gray-500);display:block;">{{contract.moveInDate}} 至 {{contract.endDate}}</text>
          <text wx:if="{{contract.documentPeriod}}" style="font-size:24rpx;color:#B45309;display:block;margin-top:8rpx;">纸面合同：{{contract.documentPeriod}}</text>
          <text style="font-size:24rpx;color:var(--gray-500);display:block;margin-top:8rpx;">实际状态：{{contract.occupancyText}}</text>
          <text style="font-size:24rpx;color:var(--gray-500);display:block;margin-top:8rpx;">租金已缴至：{{contract.rentCoveredUntil}} · 下一期起算：{{contract.nextRentDueDate}}</text>
        </view>
      </view>

      <view>
        <text class="section-title">租金条款</text>
        <view style="background:#F8FAFC;border-radius:8rpx;padding:18rpx;">
          <text style="font-size:24rpx;display:block;margin-bottom:8rpx;">月租金：￥{{contract.monthlyRent}}</text>
          <text style="font-size:24rpx;display:block;margin-bottom:8rpx;">付款方式：{{contract.paymentCycleLabel}}，每次 ￥{{contract.paymentAmount}}</text>
          <text style="font-size:24rpx;display:block;">押金：￥{{contract.deposit}}</text>
        </view>
      </view>

      <view class="contract-actions detail-actions">
        <button class="delete-button" catchtap="deleteContract" data-id="{{contract.id}}" loading="{{deleting}}">删除合同</button>
      </view>
    </view>
  </block>
</view>
