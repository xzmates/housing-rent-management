.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gray-900);
  display: block;
  margin-bottom: 14rpx;
}

.contract-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.detail-actions {
  margin-top: 32rpx;
}

.delete-button {
  margin: 0;
  color: #DC2626;
  background: #FEF2F2;
  border: 2rpx solid #FECACA;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 2.2;
}
