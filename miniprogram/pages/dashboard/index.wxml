<view class="home-page dashboard-page">
  <view class="home-hero">
    <text class="home-hero-title">房屋租赁管理</text>
    <text class="home-hero-subtitle">高效管理房源与租约，轻松掌控租赁业务</text>
  </view>

  <view class="home-shell">
    <view class="glass-panel dashboard-stats-panel">
      <view class="biz-grid">
        <view class="biz-tile">
          <view class="line-icon icon-blue symbol-home"></view>
          <view class="biz-copy">
            <text class="biz-label">房屋总数</text>
            <view class="biz-value-row">
              <text class="biz-value blue">{{stats.houses}}</text>
              <text class="biz-unit">套房</text>
            </view>
          </view>
        </view>
        <view class="biz-tile">
          <view class="line-icon icon-green symbol-contract"></view>
          <view class="biz-copy">
            <text class="biz-label">活跃合同</text>
            <view class="biz-value-row">
              <text class="biz-value green">{{stats.activeLeases}}</text>
              <text class="biz-unit">份</text>
            </view>
          </view>
        </view>
        <view class="biz-tile">
          <view class="line-icon icon-orange symbol-money"></view>
          <view class="biz-copy">
            <text class="biz-label">待收金额</text>
            <view class="biz-value-row">
              <text class="biz-value red">¥{{stats.unpaidAmount}}</text>
              <text class="biz-unit">元</text>
            </view>
          </view>
        </view>
        <view class="biz-tile">
          <view class="line-icon icon-violet symbol-shield"></view>
          <view class="biz-copy">
            <text class="biz-label">在管押金</text>
            <view class="biz-value-row">
              <text class="biz-value violet">¥{{stats.managedDeposit}}</text>
              <text class="biz-unit">元</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="glass-panel">
      <view class="section-head">
        <view>
          <text class="section-title">临近收费提醒</text>
          <text class="section-note">按未缴租金账单和应缴日期自动汇总</text>
        </view>
        <view class="reminder-summary">
          <text>本月待提醒 <text class="summary-count">{{reminderSummary.count}}</text> 笔</text>
          <text>合计 <text class="summary-money">¥{{reminderSummary.amount}}</text></text>
        </view>
      </view>

      <view wx:if="{{visibleReminderBills.length === 0}}" class="soft-empty">
        <view class="empty-line-icon symbol-wave"></view>
        <text>本月暂无临近收费</text>
      </view>

      <view wx:else class="reminder-list">
        <view wx:for="{{visibleReminderBills}}" wx:key="_id" class="reminder-row tap-card" bindtap="openReminder" data-item="{{item}}">
          <view class="reminder-house">
            <view class="mini-house-icon symbol-home"></view>
            <view>
              <text class="reminder-main">{{item.houseCode}} · {{item.houseAddress}}</text>
              <text class="reminder-sub">{{item.tenantName || '未知租客'}}</text>
            </view>
          </view>
          <view class="reminder-date">
            <text>{{item.dueDateStr}} 应缴</text>
            <text class="status-pill {{item.statusClass}}">{{item.statusText}}</text>
          </view>
          <view class="reminder-amount">
            <text>¥{{item.remaining}}</text>
            <view class="chevron"></view>
          </view>
        </view>
      </view>

      <view wx:if="{{reminderSummary.count > 4}}" class="view-all-row" bindtap="goToBills">
        <text>查看全部提醒</text>
        <view class="chevron"></view>
      </view>
    </view>

    <view class="glass-panel">
      <view class="section-head">
        <text class="section-title">快捷操作</text>
      </view>
      <view class="quick-grid">
        <navigator url="/pages/create-lease/index" class="quick-tile tap-card">
          <view class="quick-icon icon-blue symbol-plus"></view>
          <text>新建合同</text>
          <view class="quick-arrow chevron"></view>
        </navigator>
        <navigator url="/pages/prepay-rent/index" class="quick-tile tap-card">
          <view class="quick-icon icon-green symbol-money"></view>
          <text>提前收租</text>
          <view class="quick-arrow chevron"></view>
        </navigator>
        <navigator url="/pages/import/index" class="quick-tile tap-card">
          <view class="quick-icon icon-violet symbol-upload"></view>
          <text>语音助手</text>
          <view class="quick-arrow chevron"></view>
        </navigator>
        <navigator url="/pages/batch-meter/index" class="quick-tile tap-card">
          <view class="quick-icon icon-orange symbol-meter"></view>
          <text>批量抄表</text>
          <view class="quick-arrow chevron"></view>
        </navigator>
      </view>
    </view>

    <view class="glass-panel contract-feature">
      <view class="contract-art">
        <view class="paper-lines"></view>
      </view>
      <view class="contract-content">
        <text class="section-title">合同查询</text>
        <text class="section-note">查询历史合同与收入明细，全面掌握经营情况</text>
        <navigator url="/pages/contract/index" class="contract-button tap-card">
          <text>查看合同和历史收入</text>
          <view class="chevron contract-chevron"></view>
        </navigator>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading">
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>
