<view class="home-page dashboard-page">
  <view class="home-hero">
    <text class="home-hero-title">房屋租赁管理</text>
    <text class="home-hero-subtitle">高效管理房源与租约，轻松掌控租赁业务</text>
  </view>

  <view class="home-shell">
    <view class="glass-panel dashboard-stats-panel">
      <view class="biz-grid">
        <view class="biz-tile">
          <view class="line-icon icon-blue symbol-home"></view>
          <view class="biz-copy">
            <text class="biz-label">房屋总数</text>
            <view class="biz-value-row">
              <text class="biz-value blue">{{stats.houses}}</text>
              <text class="biz-unit">套</text>
            </view>
            <text class="biz-note">已出租 {{stats.activeLeases}} 套</text>
          </view>
        </view>
        <view class="biz-tile">
          <view class="line-icon icon-green symbol-contract"></view>
          <view class="biz-copy">
            <text class="biz-label">租客总数</text>
            <view class="biz-value-row">
              <text class="biz-value green">{{stats.tenants}}</text>
              <text class="biz-unit">人</text>
            </view>
            <text class="biz-note">入住 {{stats.activeTenants}} 人</text>
          </view>
        </view>
      </view>
    </view>

    <view class="glass-panel">
      <view class="section-head">
        <view>
          <text class="section-title">当前待收</text>
          <text class="section-note">已生成但尚未结清的账单已按房屋、租客和费用类别合并</text>
        </view>
        <view class="reminder-summary">
          <text class="summary-money">¥{{stats.currentReceivableAmount}}</text>
          <text>共 {{receivableGroups.length}} 类</text>
        </view>
      </view>

      <view wx:if="{{receivableGroups.length === 0}}" class="soft-empty">
        <view class="empty-line-icon symbol-wave"></view>
        <text>暂无待收账单</text>
      </view>

      <view wx:else class="reminder-list">
        <view wx:for="{{receivableGroups}}" wx:key="id" class="reminder-row tap-card" bindtap="openReceivableGroup" data-item="{{item}}">
          <view class="reminder-house">
            <view class="mini-house-icon symbol-home"></view>
            <view>
              <text class="reminder-main">{{item.houseLabel}} · {{item.tenantName}}</text>
              <text class="reminder-sub">{{item.typeText}} · {{item.periodText}}</text>
            </view>
          </view>
          <view class="reminder-date">
            <text class="status-pill {{item.overdueCount ? 'status-red' : 'status-blue'}}">{{item.statusText}}</text>
          </view>
          <view class="reminder-amount">
            <text>¥{{item.amount}}</text>
            <view class="chevron"></view>
          </view>
        </view>
      </view>

      <view wx:if="{{receivableGroups.length > 4}}" class="view-all-row" bindtap="goToBills">
        <text>查看全部待收账单</text>
        <view class="chevron"></view>
      </view>
    </view>

    <view wx:if="{{contractRentReminders.length}}" class="glass-panel upcoming-rent-panel">
      <view class="section-head">
        <view>
          <text class="section-title">即将收租</text>
          <text class="section-note">未来 15 天的合同提醒，未计入当前待收</text>
        </view>
        <view class="reminder-summary upcoming-summary">
          <text class="summary-money">¥{{stats.futureRentReminderAmount}}</text>
          <text>共 {{contractRentReminders.length}} 笔</text>
        </view>
      </view>

      <view class="reminder-list upcoming-rent-list">
        <view wx:for="{{contractRentReminders}}" wx:key="id" class="reminder-row upcoming-rent-row">
          <view class="reminder-house">
            <view class="mini-house-icon upcoming-house-icon symbol-home"></view>
            <view>
              <text class="reminder-main">{{item.houseCode}} - {{item.houseAddress}} · {{item.tenantName}}</text>
              <text class="reminder-sub">租金 · 到期 {{item.dueDate}}</text>
            </view>
          </view>
          <view class="reminder-date">
            <text class="status-pill status-blue">{{item.statusText}}</text>
          </view>
          <view class="reminder-amount">
            <text>¥{{item.expectedAmount}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="glass-panel">
      <view class="section-head">
        <text class="section-title">快捷操作</text>
      </view>
      <view class="quick-grid">
        <navigator url="/pages/create-lease/index" class="quick-tile tap-card">
          <view class="quick-icon icon-blue symbol-plus"></view>
          <text>新建合同</text>
          <view class="quick-arrow chevron"></view>
        </navigator>
        <navigator url="/pages/prepay-rent/index" class="quick-tile tap-card">
          <view class="quick-icon icon-green symbol-money"></view>
          <text>提前收租</text>
          <view class="quick-arrow chevron"></view>
        </navigator>
        <view class="quick-tile tap-card" bindtap="openWechatAiChat">
          <view class="quick-icon icon-blue symbol-wrench"></view>
          <text>微信AI对话</text>
          <view class="quick-arrow chevron"></view>
        </view>
        <navigator url="/pages/batch-meter/index" class="quick-tile tap-card">
          <view class="quick-icon icon-orange symbol-meter"></view>
          <text>批量抄表</text>
          <view class="quick-arrow chevron"></view>
        </navigator>
      </view>
    </view>

    <view class="glass-panel contract-feature">
      <view class="contract-art">
        <view class="paper-lines"></view>
      </view>
      <view class="contract-content">
        <text class="section-title">合同查询</text>
        <text class="section-note">查询历史合同与收入明细，全面掌握经营情况</text>
        <navigator url="/pages/contract/index" class="contract-button tap-card">
          <text>查看合同和历史收入</text>
          <view class="chevron contract-chevron"></view>
        </navigator>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading">
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>
