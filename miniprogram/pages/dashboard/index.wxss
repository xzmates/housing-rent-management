.dashboard-page .home-hero {
  min-height: 300rpx;
}

.dashboard-stats-panel {
  padding: 20rpx;
}

.biz-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.biz-tile {
  min-height: 118rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.76);
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: var(--home-shadow-soft);
}

.biz-copy {
  min-width: 0;
}

.biz-label {
  display: block;
  font-size: 26rpx;
  color: var(--home-muted);
  margin-bottom: 8rpx;
}

.biz-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.biz-value {
  font-size: 42rpx;
  line-height: 1;
  font-weight: 700;
}

.biz-value.blue { color: var(--home-blue); }
.biz-value.green { color: var(--home-green); }
.biz-value.red { color: var(--home-red); }
.biz-value.violet { color: var(--home-violet); }

.biz-unit {
  font-size: 24rpx;
  color: var(--home-muted);
}

.biz-note {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--home-muted);
}

.icon-blue { background: var(--home-blue-soft); color: var(--home-blue); }
.icon-green { background: var(--home-green-bg); color: var(--home-green); }
.icon-orange { background: var(--home-orange-bg); color: var(--home-orange); }
.icon-violet { background: var(--home-violet-bg); color: var(--home-violet); }

.reminder-summary {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--home-muted);
}

.summary-count {
  color: var(--home-blue);
  font-size: 30rpx;
  font-weight: 700;
}

.summary-money {
  color: var(--home-red);
  font-size: 34rpx;
  font-weight: 700;
}

.wechat-reminder-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #F1F7FF;
  border: 1rpx solid #D8E9FF;
}

.wechat-reminder-copy {
  min-width: 0;
  flex: 1;
}

.wechat-reminder-title {
  display: block;
  color: var(--home-ink);
  font-size: 27rpx;
  font-weight: 700;
}

.wechat-reminder-status {
  display: block;
  margin-top: 6rpx;
  color: var(--home-muted);
  font-size: 22rpx;
}

.wechat-reminder-action {
  flex-shrink: 0;
  min-width: 176rpx;
  padding: 16rpx 20rpx;
  border-radius: 32rpx;
  text-align: center;
  color: #FFFFFF;
  background: var(--home-blue);
  font-size: 24rpx;
  font-weight: 700;
}

.wechat-reminder-action.is-disabled {
  opacity: 0.52;
}

.upcoming-rent-panel { border: 1rpx solid #D8E9FF; }
.upcoming-summary .summary-money { color: var(--home-blue); }
.upcoming-rent-list { border-color: #D8E9FF; }
.upcoming-rent-row { background: #F7FBFF; }
.upcoming-rent-row .reminder-amount { color: var(--home-blue); }
.upcoming-house-icon { background: #E8F2FF; color: var(--home-blue); }


.reminder-list {
  border: 1rpx solid var(--home-line);
  border-radius: 22rpx;
  overflow: hidden;
  background: rgba(255,255,255,0.62);
}

.reminder-row {
  min-height: 92rpx;
  display: grid;
  grid-template-columns: 1.25fr 1.1fr auto;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 16rpx;
  border-bottom: 1rpx solid rgba(148,163,184,0.18);
  box-sizing: border-box;
}

.reminder-row:last-child {
  border-bottom: 0;
}

.reminder-house {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.mini-house-icon {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 16rpx;
  background: var(--home-blue-soft);
  color: var(--home-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.reminder-main {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--home-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reminder-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--home-muted);
}

.reminder-date {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 25rpx;
  color: var(--home-text);
  flex-wrap: wrap;
}

.reminder-amount {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--home-red);
}

.row-arrow {
  color: #9AA7B8;
  font-size: 36rpx;
  font-weight: 400;
}

.view-all-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  margin-top: 18rpx;
  color: var(--home-blue);
  font-size: 27rpx;
  font-weight: 700;
}

.soft-empty {
  min-height: 140rpx;
  border-radius: 22rpx;
  background: rgba(248,250,252,0.72);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--home-muted);
  font-size: 28rpx;
}

.empty-line-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
  background: var(--home-blue-soft);
  color: var(--home-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx;
}

.quick-tile {
  min-height: 172rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.72);
  border: 1rpx solid rgba(255,255,255,0.86);
  box-shadow: var(--home-shadow-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--home-ink);
  font-size: 27rpx;
  font-weight: 700;
}

.quick-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
}

.quick-arrow {
  color: var(--home-blue);
  width: 26rpx;
  height: 26rpx;
  margin-top: -4rpx;
}

.contract-chevron {
  color: #FFFFFF;
}

.contract-feature {
  display: flex;
  align-items: center;
  gap: 26rpx;
}

.contract-art {
  flex-shrink: 0;
  width: 180rpx;
  height: 150rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(234,243,255,0.95), rgba(255,255,255,0.8));
  position: relative;
  overflow: hidden;
}

.paper-lines {
  position: absolute;
  left: 42rpx;
  top: 30rpx;
  width: 88rpx;
  height: 104rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.78);
  box-shadow: inset 0 0 0 2rpx rgba(22,119,255,0.14);
}

.paper-lines::before,
.paper-lines::after {
  content: '';
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #9DC3FF;
}

.paper-lines::before { top: 28rpx; box-shadow: 0 20rpx 0 #B8D4FF; }
.paper-lines::after { top: 68rpx; width: 40rpx; }

.contract-content {
  flex: 1;
  min-width: 0;
}

.contract-button {
  height: 76rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #0F7CFF, #4C9AFF);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 24rpx;
  font-size: 29rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 28rpx rgba(22,119,255,0.22);
}

@media (max-width: 360px) {
  .wechat-reminder-bar {
    align-items: flex-start;
    flex-direction: column;
  }
  .wechat-reminder-action {
    width: 100%;
    box-sizing: border-box;
  }
  .reminder-row {
    grid-template-columns: 1fr;
  }
  .reminder-amount {
    justify-content: flex-start;
  }
  .quick-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
.cashflow-panel { margin-top: 24rpx; }
.cashflow-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 18rpx; }
.cashflow-grid view { display: flex; justify-content: space-between; gap: 10rpx; padding: 18rpx; border-radius: 18rpx; background: #F5F8FC; color: var(--home-muted); font-size: 24rpx; }
.cashflow-grid text:last-child { color: var(--home-ink); font-size: 28rpx; font-weight: 800; }
.cashflow-receivable { margin-top: 16rpx; padding: 16rpx 18rpx; border-radius: 16rpx; background: #FFF5F1; color: #B45A30; font-size: 24rpx; font-weight: 600; }
.cashflow-receivable-sub { margin-top: 8rpx; color: #B45A30; font-size: 23rpx; }
.cashflow-reminder { margin-top: 12rpx; padding: 14rpx 18rpx; border-radius: 16rpx; background: #F1F7FF; color: var(--home-blue); font-size: 24rpx; font-weight: 600; }
