<view class="home-page houses-page">
  <view class="home-hero">
    <text class="home-hero-title">房屋管理</text>
    <text class="home-hero-subtitle">共 {{houses.length}} 套房</text>
    <button class="home-hero-action" bindtap="showAddModal">
      <view class="hero-action-icon"></view>
      <text>添加</text>
    </button>
  </view>

  <view class="home-shell glass-panel">
    <view class="home-filter-row">
      <view class="filter-chip-group">
        <view class="soft-chip {{filters.status === '' ? 'active' : ''}}" bindtap="setFilter" data-key="status" data-val="">全部</view>
        <view class="soft-chip {{filters.status === 'available' ? 'active' : ''}}" bindtap="setFilter" data-key="status" data-val="available">可租</view>
        <view class="soft-chip {{filters.status === 'rented' ? 'active' : ''}}" bindtap="setFilter" data-key="status" data-val="rented">已租</view>
      </view>
      <view class="soft-search">
        <view class="search-mark"></view>
        <input placeholder="搜编号" bindinput="onSearchInput" class="home-search-input" />
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading">
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:elif="{{houses.length === 0}}" class="empty-state">
      <text class="empty-text">暂无房屋</text>
      <button class="primary-pill" bindtap="showAddModal">添加房屋</button>
    </view>

    <view wx:else class="home-list">
      <view wx:for="{{houses}}" wx:key="_id" class="house-card tap-card">
        <view class="house-head">
          <view>
            <text class="house-code">{{item.code}} {{item.address}}</text>
            <view class="house-rent-row">
              <text class="house-rent">¥{{item.rent}}</text>
              <text class="house-rent-unit">/ 月</text>
            </view>
          </view>
          <view class="status-pill {{item.status === 'available' ? 'status-green' : 'status-blue'}}">
            {{item.status === 'available' ? '可租' : '已租'}}
          </view>
        </view>

        <view class="meter-strip">
          <view class="meter-cell">
            <text class="meter-label">最近抄表</text>
            <text class="meter-value">{{item.lastMeterDate || '暂无'}}</text>
          </view>
          <view class="meter-cell">
            <text class="meter-label">电表</text>
            <text class="meter-value">{{item.electricityReading || '--'}} 度</text>
          </view>
          <view class="meter-cell">
            <text class="meter-label">水表</text>
            <text class="meter-value">{{item.waterReading || '--'}} 吨</text>
          </view>
        </view>

        <view wx:if="{{item.status === 'rented' && item.tenantInfo}}" class="house-tenant-line">
          <text>{{item.tenantInfo.name}}</text>
          <text>入住 {{item.tenantInfo.moveInDateStr}}</text>
        </view>

        <view wx:if="{{item.status === 'rented' && item.nextRentDue}}" class="rent-due-line">
          <text>下次 ¥{{item.nextRentDue.amount}}</text>
          <text>{{item.nextRentDue.dateStr}}</text>
          <text wx:if="{{item.nextRentDue.daysUntilDue > 0}}">{{item.nextRentDue.daysUntilDue}}天后</text>
          <text wx:elif="{{item.nextRentDue.daysUntilDue === 0}}">今天</text>
          <text wx:else>已逾期{{-item.nextRentDue.daysUntilDue}}天</text>
        </view>

        <view class="house-actions">
          <button class="ghost-pill" bindtap="editHouse" data-house="{{item}}">编辑</button>
          <button class="ghost-pill" bindtap="showHouseMore" data-house="{{item}}">更多</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加/编辑模态框 -->
  <view wx:if="{{showModal}}" class="modal-mask" bindtap="closeModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="flex-row justify-between align-center" style="margin-bottom:32rpx;">
        <text style="font-size:34rpx;font-weight:600;">{{editingHouse ? '编辑房屋' : '添加房屋'}}</text>
        <text bindtap="closeModal" style="font-size:40rpx;color:var(--gray-400);padding:8rpx;">✕</text>
      </view>

      <view class="form-group">
        <text class="form-label">房屋编号</text>
        <input class="form-input" value="{{form.code}}" data-field="code" bindinput="onFormInput" placeholder="如：A101" />
      </view>
      <view class="form-group">
        <text class="form-label">房屋地址</text>
        <picker mode="selector" range="{{addressOptions}}" value="{{addressIndex}}" bindchange="onAddressChange">
          <view class="form-picker">{{addressOptions[addressIndex] || '请选择地址'}}</view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">月租金（元）</text>
        <input class="form-input" value="{{form.rent}}" data-field="rent" bindinput="onFormInput" type="number" placeholder="请输入租金" />
      </view>
      <view class="form-group">
        <text class="form-label">房屋状态</text>
        <picker mode="selector" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatusChange">
          <view class="form-picker">{{statusOptions[statusIndex] || '请选择状态'}}</view>
        </picker>
      </view>

      <view class="modal-actions">
        <button class="btn" style="background:var(--gray-100);color:var(--gray-600);" bindtap="closeModal">取消</button>
        <button class="btn btn-primary" bindtap="saveHouse">{{saving ? '保存中...' : '保存'}}</button>
      </view>
    </view>
  </view>
</view>
