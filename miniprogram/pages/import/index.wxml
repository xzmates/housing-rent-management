<view class="voice-page">
  <view class="voice-top">
    <view class="voice-title-mark"></view>
    <view class="voice-title-group">
      <text class="voice-title">语音助手</text>
      <text class="voice-subtitle">像聊天一样说话，确认后才办理</text>
    </view>
    <button class="text-button top-reset" bindtap="resetConversation">重来</button>
  </view>

  <view class="notice-strip">
    <view class="notice-dot"></view>
    <text>{{unsupportedNotice}}</text>
  </view>

  <scroll-view class="chat-list" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="chat-bottom">
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="chat-row {{item.role}}">
      <view class="chat-bubble {{item.role}}">
        <text class="chat-role">{{item.role === 'assistant' ? '语音助手' : '我'}}</text>
        <text class="chat-text">{{item.text}}</text>
        <view class="chat-meta">
          <text>{{item.time}}</text>
          <button wx:if="{{item.audioUrl}}" class="mini-play" bindtap="playAudio" data-url="{{item.audioUrl}}">播放回复</button>
          <button wx:if="{{item.audioPath}}" class="mini-play" bindtap="playUserAudio" data-path="{{item.audioPath}}">播放录音</button>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="chat-row assistant">
      <view class="chat-bubble assistant thinking">
        <text class="chat-role">语音助手</text>
        <text class="chat-text">正在听写和整理，请稍等...</text>
      </view>
    </view>

    <view id="chat-bottom"></view>
  </scroll-view>

  <view wx:if="{{transcriptText}}" class="transcript-card">
    <text class="transcript-label">最近一次听写</text>
    <text class="transcript-text">{{transcriptText}}</text>
  </view>

  <button wx:if="{{showReviewFab}}" class="review-fab" bindtap="openReviewSheet">查看确认卡</button>

  <view wx:if="{{showReviewSheet}}" class="review-mask" bindtap="closeReviewSheet">
  <view class="review-sheet" catchtap="stopPropagation">
    <view class="section-headline">
      <text>确认卡</text>
      <view class="sheet-actions">
        <button class="text-button" loading="{{loading}}" bindtap="refreshPlan">重新整理</button>
        <button class="text-button" bindtap="closeReviewSheet">收起</button>
      </view>
    </view>

    <view wx:if="{{intent.supportMessage}}" class="warning-panel">
      <text>{{intent.supportMessage}}</text>
    </view>

    <view wx:if="{{intent.warnings.length > 0}}" class="warning-panel">
      <text wx:for="{{intent.warnings}}" wx:key="*this">{{item}}</text>
    </view>

    <view wx:if="{{intent.candidates.length > 0}}" class="warning-panel">
      <text>命中多个候选，请补充更准确的信息后重新生成确认卡。</text>
      <text wx:for="{{intent.candidates}}" wx:key="id">{{item.label}}</text>
    </view>

    <view wx:if="{{intent.missingSlots.length > 0}}" class="missing-panel">
      <text class="missing-title">还需要补充</text>
      <view wx:for="{{intent.missingSlots}}" wx:key="field" class="missing-chip">{{item.label}}</view>
    </view>

    <view wx:for="{{intent.reviewCards}}" wx:key="title" wx:for-index="cardIndex" class="review-card {{item.tone}}">
      <text class="review-title">{{item.title}}</text>
      <text class="review-subtitle">{{item.subtitle}}</text>
      <view class="review-field-list">
        <view wx:for="{{item.fields}}" wx:key="field" wx:for-item="field" wx:for-index="fieldIndex" class="review-field">
          <text class="review-label">{{field.label}}</text>
          <input
            wx:if="{{field.editable}}"
            class="review-input"
            value="{{field.value}}"
            data-card-index="{{cardIndex}}"
            data-field-index="{{fieldIndex}}"
            data-field="{{field.field}}"
            bindinput="onReviewInput"
          />
          <text wx:else class="review-value">{{field.value || '待补充'}}</text>
        </view>
      </view>
    </view>

    <button class="primary-action" loading="{{executing}}" disabled="{{!intent.canExecute || executing}}" bindtap="confirmExecute">
      {{intent.canExecute ? '确认执行' : '先补齐信息'}}
    </button>
  </view>
  </view>

  <view wx:if="{{result}}" class="result-hero {{result.failed > 0 ? 'failed' : 'success'}}">
    <text class="result-title">{{result.failed > 0 ? '办理未完成' : '办理完成'}}</text>
    <text class="result-summary">{{result.summary}}</text>
  </view>

  <view class="composer-safe"></view>
  <view class="chat-composer">
    <view class="manual-row">
      <input class="manual-input" value="{{inputText}}" bindinput="onTextInput" placeholder="也可以手动输入一句话调试" />
      <button class="manual-send" loading="{{loading}}" bindtap="sendText">发送</button>
    </view>
    <button
      class="record-button {{recording ? 'recording' : ''}}"
      bindtouchstart="startRecord"
      bindtouchend="stopRecord"
      bindtouchcancel="cancelRecord"
      disabled="{{loading}}"
    >
      {{recording ? '松开发送' : '按住说话'}}
    </button>
    <view class="example-wrap">
      <button wx:for="{{examples}}" wx:key="*this" class="example-pill" bindtap="useExample" data-text="{{item}}">{{item}}</button>
    </view>
  </view>
</view>
