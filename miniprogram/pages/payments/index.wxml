<view class="home-page payments-page">
  <view class="home-hero">
    <text class="home-hero-title">缴费记录</text>
    <text class="home-hero-subtitle">收付款账单明细</text>
    <button class="home-hero-action" bindtap="exportCSV"><view class="hero-action-icon export-mark"></view><text>导出</text></button>
  </view>

  <view class="home-shell glass-panel">
    <view class="payment-filter-block">
      <view class="filter-main-row">
        <picker class="filter-house-picker" mode="selector" range="{{houseOptions}}" bindchange="onHouseFilterChange">
          <view class="house-picker filter-control {{houseFilterId ? 'active' : ''}}">{{houseFilterLabel}}<text class="control-caret">⌄</text></view>
        </picker>
        <view class="date-range-inline">
          <picker class="date-picker-control" mode="date" value="{{filters.dateStart}}" bindchange="onDateStartChange">
            <view class="date-range-picker"><text>{{filters.dateStart || '开始日期'}}</text><text class="calendar-mark"></text></view>
          </picker>
          <text class="date-range-separator">至</text>
          <picker class="date-picker-control" mode="date" value="{{filters.dateEnd}}" bindchange="onDateEndChange">
            <view class="date-range-picker"><text>{{filters.dateEnd || '结束日期'}}</text><text class="calendar-mark"></text></view>
          </picker>
          <view wx:if="{{filters.dateStart || filters.dateEnd}}" class="date-range-clear" bindtap="clearDateRange">清除</view>
        </view>
      </view>
      <text class="date-range-hint">已收按收款日期统计；待收显示当前状态</text>
      <view class="filter-chip-group wrap-chips">
        <view class="soft-chip {{filters.status === '' ? 'active' : ''}}" bindtap="setFilter" data-key="status" data-val="">全部</view>
        <view class="soft-chip {{filters.status === 'unpaid' ? 'active' : ''}}" bindtap="setFilter" data-key="status" data-val="unpaid">待缴</view>
        <view class="soft-chip {{filters.status === 'paid' ? 'active' : ''}}" bindtap="setFilter" data-key="status" data-val="paid">已缴</view>
        <view class="soft-chip {{filters.type === 'rent' ? 'active' : ''}}" bindtap="setFilter" data-key="type" data-val="rent">租金</view>
        <view class="soft-chip {{filters.type === 'utility' ? 'active' : ''}}" bindtap="setFilter" data-key="type" data-val="utility">水电</view>
      </view>
    </view>

    <view class="payment-stats">
      <view class="payment-stat stat-receivable">
        <text class="stat-label-text">当前待收</text>
        <text class="stat-number">¥{{stats.currentReceivableAmount}}</text>
        <text class="stat-desc">逾期 ¥{{stats.overdueAmount}}</text>
      </view>
      <view class="payment-stat stat-settlement">
        <text class="stat-label-text">本期经营结算</text>
        <text class="stat-number">¥{{stats.operatingSettlementTotal}}</text>
        <text class="stat-desc">租金、水电和房损</text>
      </view>
      <view class="payment-stat stat-deposit">
        <text class="stat-label-text">在管押金</text>
        <text class="stat-number">¥{{stats.managedDeposit}}</text>
        <text class="stat-desc">尚未退还或抵扣</text>
      </view>
    </view>

    <view class="cashflow-detail-toggle tap-card" bindtap="toggleFinancialDetail">
      <view class="detail-toggle-title"><view class="detail-toggle-icon"></view><text>收付款明细</text></view>
      <view class="cashflow-detail-toggle-right">
        <text>{{showFinancialDetail ? '收起' : '展开详情'}}</text>
        <text class="cashflow-detail-arrow">{{showFinancialDetail ? '⌃' : '›'}}</text>
      </view>
    </view>

    <view wx:if="{{!showFinancialDetail}}" class="cashflow-collapsed-summary">结算：租金 ¥{{stats.rentSettled}} · 水电 ¥{{stats.utilitySettled}} · 房损 ¥{{stats.damageSettled}}</view>

    <view wx:if="{{showFinancialDetail}}" class="cashflow-detail">
      <text class="cashflow-detail-title">经营结算</text>
      <view class="cashflow-detail-grid">
        <text>租金 ¥{{stats.rentSettled}}</text><text>水电 ¥{{stats.utilitySettled}}</text>
        <text>房屋损失费 ¥{{stats.damageSettled}}</text>
        <text class="detail-total detail-settlement-total">经营结算合计 ¥{{stats.operatingSettlementTotal}}</text>
      </view>
      <text class="cashflow-detail-title refund-detail-title">现金流入</text>
      <view class="cashflow-detail-grid">
        <text>租金现金 ¥{{stats.rentReceived}}</text><text>水电现金 ¥{{stats.utilityReceived}}</text>
        <text>收押金 ¥{{stats.depositReceived}}</text>
        <text class="detail-total">现金流入合计 ¥{{stats.cashReceived}}</text>
      </view>
      <text class="cashflow-detail-title refund-detail-title">押金使用</text>
      <view class="cashflow-detail-grid">
        <text>房损扣除 ¥{{stats.damageDepositDeducted}}</text>
        <text wx:if="{{stats.depositOffsetRent}}">抵扣租金 ¥{{stats.depositOffsetRent}}</text>
        <text wx:if="{{stats.depositOffsetUtility}}">抵扣水电 ¥{{stats.depositOffsetUtility}}</text>
        <text wx:if="{{stats.depositOffsetOther}}">抵扣其他费用 ¥{{stats.depositOffsetOther}}</text>
      </view>
      <text class="cashflow-detail-title refund-detail-title">实际退款构成</text>
      <view class="cashflow-detail-grid">
        <text>退押金 ¥{{stats.depositRefund}}</text><text>退多收租金 ¥{{stats.rentRefund}}</text>
        <text>其他退款 ¥{{stats.otherRefund}}</text><text class="detail-total">本期实际退款 ¥{{stats.cashRefunded}}</text>
      </view>
      <text class="cashflow-detail-note">经营结算统计租金、水电和房损；现金流入只统计实际到账与收押金；押金使用是已收押金的去向，不会重复计入现金流入。</text>
    </view>

    <view class="section-head compact-head">
      <view class="bill-title-group">
        <view class="bill-title-icon"></view><text class="section-title">账单明细</text>
        <text class="section-note">共 {{bills.length}} 条，当前 {{visibleBills.length}} 条</text>
      </view>
      <picker mode="selector" range="{{displayLimitOptions}}" value="{{displayLimitIndex}}" bindchange="onDisplayLimitChange">
        <view class="bill-limit-picker">显示 {{displayLimit}} 条</view>
      </picker>
    </view>

    <view wx:if="{{loading}}" class="loading">
      <text class="loading-text">加载中...</text>
    </view>
    <view wx:elif="{{bills.length === 0}}" class="empty-state">
      <text class="empty-text">暂无账单</text>
    </view>
    <view wx:else class="payment-list">
      <view
        wx:for="{{visibleBills}}"
        wx:key="_id"
        class="payment-card tap-card {{item.status === 'paid' ? 'paid-card' : 'unpaid-card'}}"
        bindtap="showDetail"
        data-bill="{{item}}"
      >
        <view class="payment-row-main">
          <view class="payment-title-block">
            <view class="payment-title-row">
              <text class="payment-type">{{item.typeText}}</text>
              <text class="status-pill {{item.status === 'paid' ? 'status-green' : item.status === 'partial' ? 'status-orange' : 'status-red'}}">{{item.statusText}}</text>
            </view>
            <text wx:if="{{item.period}}" class="payment-period">{{item.period}}</text>
          </view>
          <text class="payment-amount">¥{{item.amount}}</text>
        </view>

        <view class="payment-meta">
          <text>{{item.houseLabel || '未关联房屋'}}</text>
          <text>{{item.tenantName || '未关联租客'}}</text>
          <text wx:if="{{item.dueDateStr}}">到期 {{item.dueDateStr}}</text>
        </view>

        <view wx:if="{{item.utilityDetail}}" class="utility-note">
          <text>{{item.utilityDetail}}</text>
        </view>

        <view class="payment-row-bottom">
          <text class="payment-balance">已缴 ¥{{item.paidAmount}} / 待缴 ¥{{item.remaining}}</text>
          <button wx:if="{{item.status !== 'paid'}}" class="primary-pill pay-pill" catchtap="showPayModal" data-bill="{{item}}">缴费</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showPayModal}}" class="modal-mask" bindtap="closePay">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="flex-row justify-between align-center" style="margin-bottom:24rpx;">
        <text style="font-size:34rpx;font-weight:600;">{{payGroupInfo ? '确认缴费' : '缴费'}}</text>
        <text bindtap="closePay" style="font-size:40rpx;color:var(--gray-400);">×</text>
      </view>

      <view wx:if="{{payBillInfo}}" style="background:var(--gray-50);border-radius:12rpx;padding:20rpx;margin-bottom:20rpx;">
        <view class="flex-row justify-between" style="margin-bottom:8rpx;">
          <text style="color:var(--gray-500);">类型</text>
          <text style="font-weight:500;">{{payBillInfo.typeText}}</text>
        </view>
        <view class="flex-row justify-between" style="margin-bottom:8rpx;">
          <text style="color:var(--gray-500);">应收</text>
          <text style="font-weight:500;">¥{{payBillInfo.amount}}</text>
        </view>
        <view class="flex-row justify-between">
          <text style="color:var(--gray-500);">待缴</text>
          <text style="font-weight:700;color:var(--danger);">¥{{payBillInfo.remaining}}</text>
        </view>
      </view>

      <view wx:if="{{payBillDetails.length}}" style="margin-bottom:20rpx;">
        <text style="font-size:27rpx;font-weight:700;color:var(--gray-700);display:block;margin-bottom:12rpx;">账单明细</text>
        <view wx:for="{{payBillDetails}}" wx:key="id" style="background:#F8FAFC;border-radius:12rpx;padding:18rpx 20rpx;margin-top:12rpx;">
          <view class="flex-row justify-between" style="gap:16rpx;">
            <text style="font-size:27rpx;font-weight:700;">{{item.typeText}}</text>
            <text style="font-size:27rpx;font-weight:700;color:var(--danger);">待缴 ¥{{item.remaining}}</text>
          </view>
          <text style="font-size:24rpx;color:var(--gray-600);display:block;margin-top:8rpx;">{{item.billDateText}}</text>
          <text style="font-size:24rpx;color:var(--gray-600);display:block;margin-top:6rpx;">{{item.houseLabel}}　{{item.tenantName}}</text>
          <text style="font-size:24rpx;color:var(--gray-600);display:block;margin-top:6rpx;">到期 {{item.dueDateStr}}</text>
          <text wx:if="{{item.utilityDetail}}" style="font-size:22rpx;color:var(--gray-500);display:block;margin-top:6rpx;">{{item.utilityDetail}}</text>
        </view>
      </view>

      <view wx:if="{{payGroupInfo}}" style="background:#EFF6FF;border:1rpx solid #BFDBFE;border-radius:12rpx;padding:20rpx;margin-bottom:20rpx;">
        <text style="font-size:26rpx;font-weight:700;color:#1D4ED8;display:block;">已选 {{payGroupInfo.count}} 笔{{payGroupInfo.typeText}}账单，按账期从早到晚处理</text>
        <text style="font-size:23rpx;color:#475569;display:block;margin-top:8rpx;">{{payGroupInfo.periodText}}</text>
        <text style="font-size:24rpx;color:#1D4ED8;display:block;margin-top:10rpx;">待缴合计 ¥{{payGroupInfo.totalAmount}}</text>
      </view>

      <view wx:if="{{rentGapWarning}}" style="background:#FFF7ED;border:1rpx solid #FDBA74;border-radius:12rpx;padding:20rpx;margin-bottom:20rpx;">
        <text style="font-size:26rpx;font-weight:700;color:#9A3412;display:block;">前面仍有 {{rentGapWarning.count}} 个未缴租金账期</text>
        <view wx:for="{{rentGapWarning.earlierBills}}" wx:key="id" style="margin-top:8rpx;">
          <text style="font-size:23rpx;color:#9A3412;display:block;">{{item.period}}：待缴 ¥{{item.remaining}}</text>
        </view>
        <text style="font-size:23rpx;color:#9A3412;display:block;margin-top:12rpx;">
          如果仍登记为 {{rentGapWarning.targetPeriod}}，该账单会已缴，但合同连续已缴日期不会越过前面的欠租。
        </text>
        <view class="modal-actions" style="margin-top:16rpx;">
          <button class="btn" style="background:#FFEDD5;color:#9A3412;" bindtap="useEarliestRentBill">优先处理最早欠租</button>
          <button class="btn btn-primary" bindtap="keepSelectedRentBill">仍登记为当前账单</button>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">{{payGroupInfo ? '本次缴费总额' : '缴费金额'}}</text>
        <input class="form-input" value="{{payAmount}}" type="digit" bindinput="onPayAmountInput" placeholder="输入金额" />
      </view>

      <view class="form-group">
        <text class="form-label">缴费方式</text>
        <picker mode="selector" range="{{['现金','微信','银行转账','其他']}}" bindchange="onPayMethodChange">
          <view class="form-picker">{{['现金','微信','银行转账','其他'][payMethodIndex || 0]}}</view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">缴费日期</text>
        <picker mode="date" value="{{payDate}}" bindchange="onPayDateChange">
          <view class="form-picker">{{payDate}}</view>
        </picker>
      </view>

      <view class="modal-actions">
        <button class="btn" style="background:var(--gray-100);color:var(--gray-600);" bindtap="closePay">取消</button>
        <button class="btn btn-primary" bindtap="confirmPay" disabled="{{paying}}">{{paying ? '处理中...' : '确认缴费'}}</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showDetailModal && detailBill}}" class="modal-mask" bindtap="closeDetail">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="flex-row justify-between align-center" style="margin-bottom:24rpx;">
        <text style="font-size:34rpx;font-weight:600;">账单详情</text>
        <text bindtap="closeDetail" style="font-size:40rpx;color:var(--gray-400);">×</text>
      </view>
      <view style="font-size:26rpx;">
        <view class="flex-row justify-between" style="padding:16rpx 0;border-bottom:2rpx solid var(--gray-100);">
          <text style="color:var(--gray-500);">类型</text>
          <text>{{detailBill.typeText}}</text>
        </view>
        <view class="flex-row justify-between" style="padding:16rpx 0;border-bottom:2rpx solid var(--gray-100);">
          <text style="color:var(--gray-500);">期间</text>
          <text>{{detailBill.period || '-'}}</text>
        </view>
        <view wx:if="{{detailBill.utilityDetail}}" style="padding:16rpx 0;border-bottom:2rpx solid var(--gray-100);">
          <view style="color:var(--gray-500);margin-bottom:8rpx;">水电明细</view>
          <text>{{detailBill.utilityDetail}}</text>
        </view>
        <view class="flex-row justify-between" style="padding:16rpx 0;border-bottom:2rpx solid var(--gray-100);">
          <text style="color:var(--gray-500);">应收</text>
          <text style="font-weight:700;">¥{{detailBill.amount}}</text>
        </view>
        <view class="flex-row justify-between" style="padding:16rpx 0;border-bottom:2rpx solid var(--gray-100);">
          <text style="color:var(--gray-500);">已收</text>
          <text>¥{{detailBill.paidAmount}}</text>
        </view>
        <view class="flex-row justify-between" style="padding:16rpx 0;border-bottom:2rpx solid var(--gray-100);">
          <text style="color:var(--gray-500);">到期日</text>
          <text>{{detailBill.dueDateStr || '-'}}</text>
        </view>
        <view class="flex-row justify-between" style="padding:16rpx 0;">
          <text style="color:var(--gray-500);">房屋</text>
          <text>{{detailBill.houseLabel}}</text>
        </view>
      </view>
      <view class="modal-actions">
        <button wx:if="{{detailBill.status !== 'paid'}}" class="btn btn-primary" catchtap="showPayModal" data-bill="{{detailBill}}">去缴费</button>
      </view>
    </view>
  </view>
</view>
