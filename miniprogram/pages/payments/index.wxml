<view class="page-container">
  <!-- 头部 -->
  <view class="flex-row justify-between align-center" style="margin-bottom:20rpx;">
    <text style="font-size:36rpx;font-weight:700;color:var(--gray-900);">账单管理</text>
    <view class="flex-row" style="gap:12rpx;">
      <button class="btn btn-small" style="background:var(--gray-100);color:var(--gray-600);border:none;" bindtap="exportCSV">导出</button>
    </view>
  </view>

  <!-- 筛选器 -->
  <view class="filter-bar">
    <picker mode="selector" range="{{houseOptions}}" bindchange="onHouseFilterChange" style="flex-shrink:0;">
      <view class="filter-btn {{houseFilterId ? 'active' : ''}}">{{houseFilterLabel}}</view>
    </picker>
    <view class="filter-btn {{filters.status === '' ? 'active' : ''}}" bindtap="setFilter" data-key="status" data-val="">全部</view>
    <view class="filter-btn {{filters.status === 'unpaid' ? 'active' : ''}}" bindtap="setFilter" data-key="status" data-val="unpaid">待缴</view>
    <view class="filter-btn {{filters.status === 'partial' ? 'active' : ''}}" bindtap="setFilter" data-key="status" data-val="partial">部分缴</view>
    <view class="filter-btn {{filters.status === 'paid' ? 'active' : ''}}" bindtap="setFilter" data-key="status" data-val="paid">已缴</view>
    <view class="filter-btn {{filters.type === 'rent' ? 'active' : ''}}" bindtap="setFilter" data-key="type" data-val="rent">租金</view>
    <view class="filter-btn {{filters.type === 'utility' ? 'active' : ''}}" bindtap="setFilter" data-key="type" data-val="utility">水电</view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-grid" style="margin-bottom:16rpx;">
    <view class="stat-card">
      <view class="stat-label">待收总额</view>
      <view class="stat-value" style="color:var(--danger);">¥{{stats.totalUnpaid}}</view>
    </view>
    <view class="stat-card">
      <view class="stat-label">已收总额</view>
      <view class="stat-value" style="color:var(--success);">¥{{stats.totalPaid}}</view>
    </view>
    <view class="stat-card">
      <view class="stat-label">待收租金</view>
      <view class="stat-value blue">¥{{stats.rentUnpaid}}</view>
    </view>
    <view class="stat-card">
      <view class="stat-label">待收水电</view>
      <view class="stat-value yellow">¥{{stats.utilityUnpay}}</view>
    </view>
  </view>

  <!-- 列表 -->
  <view wx:if="{{loading}}" class="loading"><text class="loading-text">加载中...</text></view>
  <view wx:elif="{{bills.length === 0}}" class="empty-state"><text class="empty-text">暂无账单</text></view>
  <view wx:else style="display:flex;flex-direction:column;gap:16rpx;">
    <view wx:for="{{bills}}" wx:key="_id" class="list-item" style="border-left-color:{{item.status === 'paid' ? 'var(--success)' : item.status === 'partial' ? 'var(--warning)' : 'var(--danger)'}};">
      <!-- 第一行：类型 + 期间 | 金额 -->
      <view class="flex-row justify-between align-center" style="margin-bottom:10rpx;">
        <view class="flex-row align-center" style="gap:8rpx;">
          <text style="font-size:28rpx;font-weight:700;color:var(--gray-900);">{{item.typeText}}</text>
          <text wx:if="{{item.period}}" style="font-size:22rpx;color:var(--gray-400);background:var(--gray-100);padding:2rpx 10rpx;border-radius:6rpx;">{{item.period}}</text>
        </view>
        <view class="flex-row align-center" style="gap:8rpx;">
          <text style="font-size:28rpx;font-weight:700;color:var(--gray-900);">¥{{item.amount}}</text>
          <view class="badge {{item.status === 'paid' ? 'badge-success' : item.status === 'partial' ? 'badge-warning' : 'badge-danger'}}">
            {{item.statusText}}
          </view>
        </view>
      </view>
      <!-- 第二行：房屋 | 租客 | 到期日 -->
      <view class="flex-row align-center" style="font-size:24rpx;color:var(--gray-500);margin-bottom:10rpx;gap:12rpx;">
        <text style="font-weight:500;color:var(--gray-700);">{{item.houseLabel}}</text>
        <text style="color:var(--gray-200);">|</text>
        <text>{{item.tenantName}}</text>
        <text wx:if="{{item.dueDateStr}}" style="color:var(--gray-200);">|</text>
        <text wx:if="{{item.dueDateStr}}">到期 {{item.dueDateStr}}</text>
      </view>
      <!-- 第三行：已缴/待缴 + 操作 -->
      <view class="flex-row justify-between align-center">
        <text style="font-size:22rpx;color:var(--gray-400);">已缴 ¥{{item.paidAmount}} / 待缴 ¥{{item.remaining}}</text>
        <button wx:if="{{item.status !== 'paid'}}" class="btn-small" style="background:var(--success);color:#fff;border:none;" catchtap="showPayModal" data-bill="{{item}}">缴费</button>
      </view>
    </view>
  </view>

  <!-- ====== 缴费弹窗 ====== -->
  <view wx:if="{{showPayModal}}" class="modal-mask" bindtap="closePay">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="flex-row justify-between align-center" style="margin-bottom:24rpx;">
        <text style="font-size:34rpx;font-weight:600;">缴费</text>
        <text bindtap="closePay" style="font-size:40rpx;color:var(--gray-400);">✕</text>
      </view>

      <view wx:if="{{payBillInfo}}" style="background:var(--gray-50);border-radius:12rpx;padding:20rpx;margin-bottom:20rpx;">
        <view class="flex-row justify-between" style="margin-bottom:8rpx;">
          <text style="color:var(--gray-400);">类型</text>
          <text style="font-weight:500;">{{payBillInfo.typeText}}</text>
        </view>
        <view class="flex-row justify-between" style="margin-bottom:8rpx;">
          <text style="color:var(--gray-400);">应收</text>
          <text style="font-weight:500;">¥{{payBillInfo.amount}}</text>
        </view>
        <view class="flex-row justify-between">
          <text style="color:var(--gray-400);">待缴</text>
          <text style="font-weight:700;color:var(--danger);">¥{{payBillInfo.remaining}}</text>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">缴费金额</text>
        <input class="form-input" value="{{payAmount}}" type="digit" bindinput="onPayAmountInput" placeholder="输入金额" />
      </view>

      <view class="form-group">
        <text class="form-label">缴费方式</text>
        <picker mode="selector" range="{{['现金','微信','银行转账','其他']}}" bindchange="onPayMethodChange">
          <view class="form-picker">{{['现金','微信','银行转账','其他'][payMethodIndex || 0]}}</view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">缴费日期</text>
        <picker mode="date" value="{{payDate}}" bindchange="onPayDateChange">
          <view class="form-picker">{{payDate}}</view>
        </picker>
      </view>

      <view class="modal-actions">
        <button class="btn" style="background:var(--gray-100);color:var(--gray-600);" bindtap="closePay">取消</button>
        <button class="btn btn-primary" bindtap="confirmPay" disabled="{{paying}}">{{paying ? '处理中...' : '确认缴费'}}</button>
      </view>
    </view>
  </view>

  <!-- ====== 详情弹窗 ====== -->
  <view wx:if="{{showDetailModal && detailBill}}" class="modal-mask" bindtap="closeDetail">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="flex-row justify-between align-center" style="margin-bottom:24rpx;">
        <text style="font-size:34rpx;font-weight:600;">账单详情</text>
        <text bindtap="closeDetail" style="font-size:40rpx;color:var(--gray-400);">✕</text>
      </view>
      <view style="font-size:26rpx;">
        <view class="flex-row justify-between" style="padding:16rpx 0;border-bottom:2rpx solid var(--gray-100);">
          <text style="color:var(--gray-400);">类型</text>
          <text>{{detailBill.typeText}}</text>
        </view>
        <view class="flex-row justify-between" style="padding:16rpx 0;border-bottom:2rpx solid var(--gray-100);">
          <text style="color:var(--gray-400);">期间</text>
          <text>{{detailBill.period || '—'}}</text>
        </view>
        <view class="flex-row justify-between" style="padding:16rpx 0;border-bottom:2rpx solid var(--gray-100);">
          <text style="color:var(--gray-400);">应收</text>
          <text style="font-weight:700;">¥{{detailBill.amount}}</text>
        </view>
        <view class="flex-row justify-between" style="padding:16rpx 0;border-bottom:2rpx solid var(--gray-100);">
          <text style="color:var(--gray-400);">已收</text>
          <text>¥{{detailBill.paidAmount}}</text>
        </view>
        <view class="flex-row justify-between" style="padding:16rpx 0;border-bottom:2rpx solid var(--gray-100);">
          <text style="color:var(--gray-400);">到期日</text>
          <text>{{detailBill.dueDateStr || '—'}}</text>
        </view>
        <view class="flex-row justify-between" style="padding:16rpx 0;">
          <text style="color:var(--gray-400);">房屋</text>
          <text>{{detailBill.houseLabel}}</text>
        </view>
      </view>
      <view class="modal-actions">
        <button wx:if="{{detailBill.status !== 'paid'}}" class="btn btn-primary" catchtap="showPayModal" data-bill="{{detailBill}}">去缴费</button>
      </view>
    </view>
  </view>
</view>
