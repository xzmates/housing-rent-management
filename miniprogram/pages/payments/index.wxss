.payments-page .home-hero {
  min-height: 252rpx;
}

.payment-filter-block {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.house-picker {
  display: inline-flex;
  align-self: flex-start;
  max-width: 100%;
}

.wrap-chips {
  flex-wrap: wrap;
}

.payment-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-bottom: 28rpx;
}

.payment-stat {
  min-height: 138rpx;
  border-radius: 22rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255,255,255,0.78);
}

.stat-label-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.3;
  color: var(--home-muted);
  font-weight: 600;
}

.stat-number {
  display: block;
  margin-top: 16rpx;
  font-size: 40rpx;
  line-height: 1.1;
  font-weight: 800;
  color: var(--home-ink);
}

.stat-danger { background: #FFF1F1; }
.stat-danger .stat-number { color: #D94542; }
.stat-success { background: #EAF8F1; }
.stat-success .stat-number { color: #13945F; }
.stat-blue { background: #E8F2FF; }
.stat-blue .stat-number { color: var(--home-blue); }
.stat-orange { background: #FFF4E5; }
.stat-orange .stat-number { color: #C96D13; }
.stat-violet { background: #F0EDFF; }
.stat-violet .stat-number { color: var(--home-violet); }

.compact-head {
  margin-top: 4rpx;
}

.payment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.payment-card {
  border-radius: 24rpx;
  padding: 24rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F8FBFF 100%);
  border: 1rpx solid rgba(207, 220, 236, 0.72);
  box-shadow: var(--home-shadow-soft);
}

.payment-card.unpaid-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF8F8 100%);
}

.payment-card.paid-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #F5FCF8 100%);
}

.payment-row-main,
.payment-row-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.payment-title-block {
  min-width: 0;
  flex: 1;
}

.payment-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.payment-type {
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 800;
  color: var(--home-ink);
}

.payment-period {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: var(--home-muted);
}

.payment-amount {
  flex-shrink: 0;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 800;
  color: var(--home-ink);
}

.payment-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 18rpx;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: var(--home-muted);
}

.utility-note {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #F1F6FD;
  color: #506179;
  font-size: 24rpx;
  line-height: 1.4;
}

.payment-row-bottom {
  margin-top: 18rpx;
}

.payment-balance {
  font-size: 24rpx;
  line-height: 1.35;
  color: var(--home-muted);
}

.pay-pill {
  min-width: 132rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

@media (max-width: 360px) {
  .payment-stats {
    grid-template-columns: 1fr;
  }

  .payment-row-main,
  .payment-row-bottom {
    align-items: flex-start;
    flex-direction: column;
  }
}
