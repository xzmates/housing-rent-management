.payments-page .home-hero { min-height: 252rpx; }
.export-mark::before { width: 4rpx; height: 20rpx; left: 12rpx; top: 1rpx; }
.export-mark::after { width: 10rpx; height: 10rpx; left: 7rpx; top: 7rpx; border-right: 4rpx solid #FFF; border-bottom: 4rpx solid #FFF; background: transparent; border-radius: 0; transform: rotate(45deg); }
.payments-page .home-shell { margin-top: -8rpx; padding: 32rpx 28rpx 44rpx; border-radius: 34rpx 34rpx 0 0; background: rgba(255,255,255,.96); box-shadow: 0 -2rpx 0 rgba(255,255,255,.7), 0 20rpx 42rpx rgba(53,114,184,.12); }

.payment-filter-block {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.filter-main-row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  gap: 14rpx;
}

.filter-house-picker { flex: 1 1 0; min-width: 0; }
.house-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.filter-control, .date-range-picker { box-sizing: border-box; min-height: 70rpx; border: 1rpx solid #D9E6F5; background: #F9FBFE; box-shadow: inset 0 1rpx 0 rgba(255,255,255,.9); }
.filter-control { padding: 0 18rpx; border-radius: 18rpx; color: #0D244A; font-size: 25rpx; font-weight: 700; }
.control-caret { margin-left: 8rpx; color: #8092AE; font-size: 32rpx; line-height: 1; }

.wrap-chips {
  flex-wrap: wrap;
}

.date-range-inline {
  display: flex;
  align-items: center;
  flex: 2.15 1 0;
  min-width: 0;
  gap: 10rpx;
}

.date-picker-control { flex: 1 1 0; min-width: 0; }

.date-range-hint {
  color: #627896;
  font-size: 23rpx;
  line-height: 1.4;
}

.date-range-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  overflow: hidden;
  padding: 0 12rpx;
  border-radius: 18rpx;
  color: #2A3951;
  font-size: 23rpx;
  white-space: nowrap;
}

.calendar-mark { position: relative; flex: 0 0 22rpx; width: 22rpx; height: 20rpx; border: 2rpx solid #8AA1BF; border-radius: 4rpx; box-sizing: border-box; }
.calendar-mark::before { content: ''; position: absolute; left: 2rpx; right: 2rpx; top: 5rpx; border-top: 2rpx solid #8AA1BF; }
.calendar-mark::after { content: ''; position: absolute; left: 4rpx; top: -5rpx; width: 10rpx; height: 5rpx; border-left: 2rpx solid #8AA1BF; border-right: 2rpx solid #8AA1BF; }

.date-range-separator {
  color: #64748B;
  font-size: 25rpx;
}

.date-range-clear {
  padding: 8rpx 2rpx;
  color: #247BFF;
  font-size: 21rpx;
}

.payment-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.payment-stat {
  min-height: 166rpx;
  border-radius: 20rpx;
  padding: 18rpx 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255,255,255,0.78);
}

.stat-label-text {
  display: block;
  font-size: 23rpx;
  line-height: 1.3;
  color: var(--home-muted);
  font-weight: 600;
}

.stat-number {
  margin-top: 14rpx;
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 800;
  color: var(--home-ink);
}

.stat-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--home-muted);
  font-size: 20rpx;
  line-height: 1.35;
}

.stat-receivable { border-color: #FFD7D7; background: #FFF4F4; }
.stat-settlement { border-color: #D4F0E1; background: #EFFBF5; }
.stat-deposit { border-color: #D4E3FC; background: #F1F7FF; }
.stat-receivable .stat-number { color: #D94542; }
.stat-settlement .stat-number { color: #13945F; }
.stat-deposit .stat-number { color: #247BFF; }

.stat-danger { background: #FFF1F1; }
.stat-danger .stat-number { color: #D94542; }
.stat-success { background: #EAF8F1; }
.stat-success .stat-number { color: #13945F; }
.stat-blue { background: #E8F2FF; }
.stat-blue .stat-number { color: var(--home-blue); }
.stat-orange { background: #FFF4E5; }
.stat-orange .stat-number { color: #C96D13; }
.cashflow-detail-toggle { display: flex; align-items: center; justify-content: space-between; margin: 0 0 12rpx; min-height: 92rpx; padding: 0 22rpx; border: 1rpx solid #DCE8F6; border-radius: 20rpx; background: #FAFCFF; color: #0D244A; font-size: 29rpx; font-weight: 800; }
.detail-toggle-title { display: flex; align-items: center; gap: 16rpx; }
.detail-toggle-icon, .bill-title-icon { position: relative; width: 42rpx; height: 42rpx; border-radius: 10rpx; background: linear-gradient(135deg, #4C96FF, #247BFF); }
.detail-toggle-icon::before, .bill-title-icon::before { content: ''; position: absolute; left: 11rpx; top: 11rpx; width: 18rpx; height: 3rpx; border-radius: 3rpx; background: #FFF; box-shadow: 0 8rpx 0 #FFF, 0 16rpx 0 #FFF; }
.cashflow-detail-toggle-right { display: flex; align-items: center; gap: 10rpx; color: #247BFF; font-size: 24rpx; font-weight: 700; }
.cashflow-detail-arrow { font-size: 34rpx; line-height: 1; }
.cashflow-collapsed-summary { margin: -2rpx 0 24rpx; padding: 0 4rpx; color: #63738A; font-size: 23rpx; line-height: 1.45; }
.cashflow-detail { margin: 0 0 28rpx; padding: 22rpx; border-radius: 22rpx; background: #F7FAFE; }
.cashflow-detail-title { display: block; margin-bottom: 14rpx; color: var(--home-ink); font-size: 28rpx; font-weight: 800; }
.refund-detail-title { margin-top: 22rpx; }
.cashflow-detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.cashflow-detail-grid text { padding: 14rpx; border-radius: 14rpx; background: #FFFFFF; color: var(--home-muted); font-size: 23rpx; }
.cashflow-detail-grid .detail-total { grid-column: 1 / -1; color: var(--home-ink); font-weight: 800; background: #EAF8F1; }
.cashflow-detail-grid .detail-settlement-total { background: #E8F2FF; }
.cashflow-detail-note { display: block; margin-top: 14rpx; color: var(--home-muted); font-size: 22rpx; line-height: 1.5; }

.compact-head {
  margin-top: 12rpx;
  align-items: center;
}

.bill-title-group { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 14rpx; }
.bill-title-group .section-title { font-size: 33rpx; color: #0D244A; }
.bill-title-group .section-note { width: 100%; margin-left: 56rpx; color: #67768D; }
.bill-limit-picker { padding: 14rpx 18rpx; border: 1rpx solid #D4E2F5; border-radius: 16rpx; background: #F7FAFF; color: #247BFF; font-size: 23rpx; font-weight: 700; }

.payment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pagination-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 4rpx 8rpx;
}

.pagination-button {
  margin: 0;
  min-width: 136rpx;
  padding: 0 20rpx;
  line-height: 60rpx;
  border: 1rpx solid #BFD2EC;
  border-radius: 12rpx;
  background: #F7FAFF;
  color: #247BFF;
  font-size: 24rpx;
  font-weight: 700;
}

.pagination-button[disabled] {
  border-color: #E1E7EF;
  background: #F7F8FA;
  color: #A7B2C1;
}

.pagination-status { color: #67768D; font-size: 24rpx; }

.payment-card {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  padding: 26rpx 24rpx 24rpx 30rpx;
  background: #FFF;
  border: 1rpx solid #DDE7F1;
  box-shadow: 0 8rpx 20rpx rgba(35,83,137,.06);
}

.payment-card::before { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 7rpx; background: #33B67A; }

.payment-card.unpaid-card {
  background: #FFFDFD;
}
.payment-card.unpaid-card::before { background: #E35A5A; }

.payment-card.paid-card {
  background: #FFFFFF;
}

.payment-row-main,
.payment-row-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.payment-title-block {
  min-width: 0;
  flex: 1;
}

.payment-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.payment-type {
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 800;
  color: var(--home-ink);
}

.payment-period {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.35;
  color: var(--home-muted);
}

.payment-amount {
  flex-shrink: 0;
  font-size: 39rpx;
  line-height: 1.2;
  font-weight: 800;
  color: var(--home-ink);
}

.payment-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.35;
  color: var(--home-muted);
}

.utility-note {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #F3F8FF;
  color: #506179;
  font-size: 24rpx;
  line-height: 1.4;
}

.payment-row-bottom {
  margin-top: 18rpx;
}

.payment-balance {
  font-size: 23rpx;
  line-height: 1.35;
  color: var(--home-muted);
}

.pay-pill {
  min-width: 132rpx;
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

@media (max-width: 360px) {
  .payment-stats {
    grid-template-columns: 1fr;
  }

  .payment-row-main,
  .payment-row-bottom {
    align-items: flex-start;
    flex-direction: column;
  }

  .filter-main-row { align-items: stretch; flex-wrap: wrap; }
  .filter-house-picker { flex-basis: 100%; }
  .date-range-inline { flex-basis: 100%; }
  .payment-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stat-deposit { grid-column: 1 / -1; }
  .stat-number { font-size: 36rpx; }
}
