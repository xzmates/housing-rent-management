<view class="page-container">
  <!-- 头部 -->
  <view class="flex-row justify-between align-center" style="margin-bottom:20rpx;">
    <view>
      <text style="font-size:36rpx;font-weight:700;color:var(--gray-900);">租客管理</text>
      <text class="stat-label">共 {{filteredTenants.length}} 位租客</text>
    </view>
    <button class="btn btn-primary btn-small" bindtap="showAddModal">+ 添加</button>
  </view>

  <!-- 筛选器 -->
  <view class="filter-bar">
    <view class="filter-btn {{filters.status === '' ? 'active' : ''}}" bindtap="setFilter" data-key="status" data-val="">全部</view>
    <view class="filter-btn {{filters.status === 'active' ? 'active' : ''}}" bindtap="setFilter" data-key="status" data-val="active">在住的</view>
    <view class="filter-btn {{filters.status === 'inactive' ? 'active' : ''}}" bindtap="setFilter" data-key="status" data-val="inactive">无合同</view>
    <view class="filter-btn" style="display:flex;align-items:center;background:var(--gray-50);border-color:var(--gray-100);padding:8rpx 16rpx;gap:4rpx;">
      <text style="font-size:22rpx;color:var(--gray-400);">🔍</text>
      <input placeholder="搜姓名" bindinput="onNameSearchInput" value="{{nameSearch}}" style="width:100rpx;font-size:24rpx;" />
    </view>
  </view>

  <!-- 加载/空状态 -->
  <view wx:if="{{loading}}" class="loading"><text class="loading-text">加载中...</text></view>
  <view wx:elif="{{filteredTenants.length === 0}}" class="empty-state">
    <text class="empty-text">{{nameSearch ? '未找到匹配租客' : '暂无租客'}}</text>
    <button wx:if="{{!nameSearch}}" class="btn btn-primary btn-small" bindtap="showAddModal">添加租客</button>
  </view>

  <!-- 租客列表 -->
  <view wx:else style="display:flex;flex-direction:column;gap:16rpx;">
    <view wx:for="{{filteredTenants}}" wx:key="_id" class="list-item" style="border-left-color:{{item.isActive ? 'var(--success)' : 'var(--gray-300)'}};">
      <!-- 第一行：姓名 + 状态 -->
      <view class="flex-row justify-between align-center" style="margin-bottom:10rpx;">
        <view class="flex-row align-center" style="gap:10rpx;">
          <text style="font-size:30rpx;font-weight:700;color:var(--gray-900);">{{item.name}}</text>
          <view style="width:14rpx;height:14rpx;border-radius:50%;{{item.isActive ? 'background:var(--success);' : 'background:var(--gray-400);'}}"></view>
        </view>
        <view class="badge {{item.isActive ? 'badge-success' : 'badge-gray'}}">
          {{item.isActive ? '在住' : '无合同'}}
        </view>
      </view>

      <!-- 第二行：手机 | 身份证 | 房屋 -->
      <view class="flex-row align-center" style="font-size:24rpx;color:var(--gray-500);margin-bottom:14rpx;gap:12rpx;">
        <text>{{item.phone || '—'}}</text>
        <text style="color:var(--gray-300);">|</text>
        <text>{{item.idCard ? item.idCard : '—'}}</text>
        <text wx:if="{{item.houseLabel}}" style="color:var(--gray-300);">|</text>
        <text wx:if="{{item.houseLabel}}">{{item.houseLabel}}</text>
      </view>

      <!-- 第三行：操作按钮 -->
      <view class="flex-row" style="gap:12rpx;">
        <button class="btn-small" style="background:var(--primary-bg);color:var(--primary);border:none;" bindtap="viewTenantDetail" data-tenant-id="{{item._id}}">详情</button>
        <button wx:if="{{item.isActive}}" class="btn-small" style="background:var(--gray-50);color:var(--gray-600);border:none;" bindtap="editTenant" data-tenant="{{item}}">编辑</button>
        <button wx:if="{{item.isActive}}" class="btn-small" style="background:var(--warning-light);color:var(--warning);border:none;" bindtap="handleMoveOut" data-tenant="{{item}}">退租</button>
        <button wx:if="{{!item.isActive}}" class="btn-small" style="background:var(--primary-bg);color:var(--primary);border:none;" bindtap="goToCreateLease" data-tenant-id="{{item._id}}">创建合同</button>
        <button wx:if="{{!item.isActive}}" class="btn-small" style="background:var(--gray-50);color:var(--gray-600);border:none;" bindtap="editTenant" data-tenant="{{item}}">编辑</button>
        <button class="btn-small" style="background:var(--danger-light);color:var(--danger);border:none;" bindtap="deleteTenant" data-id="{{item._id}}">删除</button>
      </view>
    </view>
  </view>

  <!-- ====== 添加/编辑租客模态框（纯人员信息） ====== -->
  <view wx:if="{{showAddModal}}" class="modal-mask" bindtap="closeModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="flex-row justify-between align-center" style="margin-bottom:24rpx;">
        <text style="font-size:34rpx;font-weight:600;">{{editingTenant ? '编辑租客' : '添加租客'}}</text>
        <text bindtap="closeModal" style="font-size:40rpx;color:var(--gray-400);">✕</text>
      </view>

      <view class="form-group">
        <text class="form-label">姓名</text>
        <input class="form-input" value="{{form.name}}" data-field="name" bindinput="onFormInput" placeholder="租客姓名" />
      </view>
      <view class="form-group">
        <text class="form-label">手机号</text>
        <input class="form-input" value="{{form.phone}}" data-field="phone" bindinput="onFormInput" placeholder="11位手机号码" type="number" />
      </view>
      <view class="form-group">
        <text class="form-label">身份证号</text>
        <input class="form-input" value="{{form.idCard}}" data-field="idCard" bindinput="onFormInput" placeholder="18位身份证号码" />
      </view>

      <view wx:if="{{!editingTenant}}" style="background:var(--primary-bg);border-radius:12rpx;padding:20rpx;margin-bottom:20rpx;">
        <text style="color:var(--primary);font-size:24rpx;">💡 添加租客后可为其创建租赁合同</text>
      </view>

      <view class="modal-actions">
        <button class="btn" style="background:var(--gray-100);color:var(--gray-600);" bindtap="closeModal">取消</button>
        <button class="btn btn-primary" bindtap="saveTenant">{{saving ? '保存中...' : '保存'}}</button>
      </view>
    </view>
  </view>

  <!-- ====== 退租模态框 ====== -->
  <view wx:if="{{showMoveOutModal}}" class="modal-mask" bindtap="closeMoveOut">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="flex-row justify-between align-center" style="margin-bottom:24rpx;">
        <text style="font-size:34rpx;font-weight:600;">办理退租</text>
        <text bindtap="closeMoveOut" style="font-size:40rpx;color:var(--gray-400);">✕</text>
      </view>

      <view style="background:#FFFBEB;border-radius:12rpx;padding:20rpx;margin-bottom:20rpx;">
        <text style="color:#92400E;">租客 <text style="font-weight:600;">{{moveOutTenantName}}</text> 将从 {{moveOutTenantHouse}} 退租</text>
      </view>

      <view class="form-group">
        <text class="form-label">退租日期</text>
        <picker mode="date" value="{{moveOutDate}}" bindchange="onMoveOutDateChange">
          <view class="form-picker">{{moveOutDate}}</view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">损坏扣款（元）</text>
        <input class="form-input" value="{{damageDeduction}}" type="digit" placeholder="0" bindinput="onDamageInput" />
      </view>

      <!-- 结算结果 -->
      <view wx:if="{{settlementResult}}" style="background:#EFF6FF;border-radius:12rpx;padding:20rpx;margin-bottom:20rpx;">
        <text style="color:#1D4ED8;font-weight:500;margin-bottom:12rpx;">结算结果</text>
        <view wx:if="{{settlementResult.refundAmount > 0}}" class="flex-row justify-between" style="margin-top:8rpx;">
          <text style="color:#065F46;">应退金额</text>
          <text style="color:#065F46;font-weight:700;">¥{{settlementResult.refundAmount}}</text>
        </view>
        <view wx:if="{{settlementResult.extraPayment > 0}}" class="flex-row justify-between" style="margin-top:8rpx;">
          <text style="color:#991B1B;">需补缴</text>
          <text style="color:#991B1B;font-weight:700;">¥{{settlementResult.extraPayment}}</text>
        </view>
      </view>

      <view class="modal-actions">
        <button class="btn" style="background:var(--gray-100);color:var(--gray-600);" bindtap="closeMoveOut">取消</button>
        <button class="btn" style="background:#EA580C;color:#FFFFFF;" bindtap="confirmMoveOut">{{processingMoveOut ? '处理中...' : '确认退租'}}</button>
      </view>
    </view>
  </view>
</view>
