.tenants-page .home-hero {
  min-height: 252rpx;
}

.tenant-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.tenant-card {
  border-radius: 24rpx;
  padding: 26rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F8FBFF 100%);
  border: 1rpx solid rgba(207, 220, 236, 0.72);
  box-shadow: var(--home-shadow-soft);
}

.tenant-main {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: stretch;
}

.tenant-info {
  min-width: 0;
  flex: 1;
}

.tenant-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.tenant-name {
  max-width: 320rpx;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--home-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tenant-line {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.38;
  color: var(--home-muted);
}

.tenant-phone {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #1E5BAA;
}

.tenant-actions {
  width: 168rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: stretch;
}

.tenant-actions .primary-pill,
.tenant-actions .ghost-pill {
  width: 100%;
  height: 62rpx;
  line-height: 62rpx;
  padding: 0;
  font-size: 25rpx;
}

.detail-pill {
  box-shadow: 0 8rpx 18rpx rgba(22,119,255,0.16);
}

.more-pill {
  background: rgba(241, 245, 249, 0.72);
}

.tenant-delete-btn {
  background: #FEF2F2;
  color: #B91C1C;
  border: 2rpx solid #FECACA;
}

@media (max-width: 360px) {
  .tenant-main {
    flex-direction: column;
  }

  .tenant-actions {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
.entity-tabs { display:flex; gap:8rpx; margin-bottom:24rpx; padding:6rpx; border-radius:18rpx; background:#EDF3FA; }
.entity-tab { flex:1; padding:18rpx 0; border-radius:14rpx; color:#627896; font-size:27rpx; font-weight:700; text-align:center; }
.entity-tab.active { background:#FFF; color:#1677FF; box-shadow:0 4rpx 14rpx rgba(30,79,140,.10); }
