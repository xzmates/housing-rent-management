<view class="page-container">
  <view class="card">
    <view class="card-header">
      <text class="card-title">当前单价设置</text>
    </view>
    <view class="stats-grid">
      <view class="stat-card" style="background:#EFF6FF;border:2rpx solid #BFDBFE;">
        <view class="stat-label">电费单价</view>
        <view class="stat-value blue">¥{{settings.electricityPrice}}/度</view>
      </view>
      <view class="stat-card" style="background:#F0FDF4;border:2rpx solid #BBF7D0;">
        <view class="stat-label">水费单价</view>
        <view class="stat-value green">¥{{settings.waterPrice}}/吨</view>
      </view>
    </view>
    <navigator url="/pages/settings/index" style="font-size:24rpx;color:var(--primary);margin-top:8rpx;">修改单价 ›</navigator>
  </view>

  <view class="card">
    <view class="card-header">
      <text class="card-title">计算水电费</text>
    </view>

    <view class="form-group">
      <text class="form-label">选择房屋</text>
      <picker mode="selector" range="{{houseLabels}}" value="{{form.houseIndex}}" bindchange="onHouseChange">
        <view class="form-picker">{{houseLabels[form.houseIndex] || '请选择房屋'}}</view>
      </picker>
    </view>

    <view wx:if="{{currentTenant}}" style="background:var(--primary-bg);border-radius:12rpx;padding:16rpx;margin-bottom:16rpx;">
      <text style="color:var(--primary);font-size:24rpx;">当前租客：{{currentTenant.name}}</text>
    </view>

    <view wx:if="{{lastReading}}" style="background:var(--gray-50);border-radius:10rpx;padding:16rpx;margin-bottom:16rpx;">
      <text style="font-size:24rpx;color:var(--gray-700);display:block;">上次抄表：{{lastReadingDate}}</text>
      <text style="font-size:24rpx;color:var(--gray-700);display:block;margin-top:6rpx;">电表 {{lastReading.electricityReading}} 度 · 水表 {{lastReading.waterReading}} 吨</text>
    </view>

    <view wx:elif="{{currentLease}}" style="background:var(--gray-50);border-radius:10rpx;padding:16rpx;margin-bottom:16rpx;">
      <text style="font-size:24rpx;color:var(--gray-500);">暂无历史抄表记录，将从合同入住读数开始计算。</text>
    </view>

    <view class="flex-row" style="gap:20rpx;">
      <view class="form-group" style="flex:1;">
        <text class="form-label">当前电表读数（度）</text>
        <input class="form-input" value="{{form.currentElectricity}}" bindinput="onElecInput" type="digit" placeholder="电表读数" />
      </view>
      <view class="form-group" style="flex:1;">
        <text class="form-label">当前水表读数（吨）</text>
        <input class="form-input" value="{{form.currentWater}}" bindinput="onWaterInput" type="digit" placeholder="水表读数" />
      </view>
    </view>

    <button class="btn btn-primary btn-block" bindtap="calculateBill" style="margin-top:12rpx;" disabled="{{!currentLease || calculating}}">
      {{calculating ? '处理中...' : '预览水电费'}}
    </button>
  </view>

  <view wx:if="{{result}}" class="card" style="background:#F0FDF4;border:2rpx solid #BBF7D0;">
    <view class="card-header">
      <text class="card-title" style="color:#065F46;">计算结果</text>
    </view>
    <view class="stats-grid">
      <view class="stat-card" style="background:#EFF6FF;">
        <view class="stat-label">用电量</view>
        <view class="stat-value blue">{{result.electricityUsage}} 度</view>
      </view>
      <view class="stat-card" style="background:#F0FDF4;">
        <view class="stat-label">用水量</view>
        <view class="stat-value green">{{result.waterUsage}} 吨</view>
      </view>
      <view class="stat-card" style="background:#FFFBEB;">
        <view class="stat-label">电费</view>
        <view class="stat-value yellow">¥{{result.electricityCost}}</view>
      </view>
      <view class="stat-card" style="background:#FAF5FF;">
        <view class="stat-label">水费</view>
        <view class="stat-value" style="color:#7C3AED;">¥{{result.waterCost}}</view>
      </view>
    </view>
    <view style="background:#D1FAE5;border-radius:12rpx;padding:20rpx;margin-top:12rpx;">
      <view class="flex-row justify-between align-center">
        <text style="font-size:28rpx;font-weight:600;color:#065F46;">总费用</text>
        <text style="font-size:40rpx;font-weight:700;color:#065F46;">¥{{result.totalCost}}</text>
      </view>
    </view>
    <view style="background:#D1FAE5;border-radius:8rpx;padding:12rpx;margin-top:12rpx;">
      <text style="color:#065F46;font-size:24rpx;">这是云端费用预览，请核对后确认保存。</text>
    </view>
    <button wx:if="{{confirmationId}}" class="btn btn-primary btn-block" bindtap="confirmMeterReading" disabled="{{calculating}}" style="margin-top:12rpx;">确认保存抄表并生成账单</button>
  </view>

  <view class="card" style="margin-top:20rpx;">
    <view class="card-header">
      <text class="card-title">最近水电记录</text>
    </view>
    <view wx:if="{{utilityRecords.length === 0}}" class="empty-state" style="padding:40rpx 0;">
      <text class="empty-text">暂无水电记录</text>
    </view>
    <view wx:else>
      <view wx:for="{{utilityRecords}}" wx:key="_id" class="list-item" style="margin-bottom:8rpx;">
        <view class="flex-row justify-between">
          <view>
            <text style="font-size:26rpx;font-weight:500;">{{item.recordType === 'move_in_baseline' ? '入住基准读数' : currentTenant.name}}</text>
          </view>
          <text style="font-size:28rpx;font-weight:700;">¥{{item.totalCost}}</text>
        </view>
        <view class="flex-row" style="font-size:22rpx;color:var(--gray-400);margin-top:6rpx;">
          <text>电 {{item.electricityReading}} 度</text>
          <text style="margin:0 12rpx;">·</text>
          <text>水 {{item.waterReading}} 吨</text>
        </view>
      </view>
    </view>
  </view>
</view>
