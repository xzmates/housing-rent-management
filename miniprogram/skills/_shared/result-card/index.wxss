.result-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
}
.result-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 28rpx 0;
}
.result-mark {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.result-mark.confirm { background: #1677FF; }
.result-mark.result { background: #059669; }
.result-title-block { flex: 1; min-width: 0; }
.result-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
  line-height: 1.3;
}
.result-subtitle {
  display: block;
  font-size: 24rpx;
  color: #64748B;
  margin-top: 4rpx;
}
.result-summary {
  padding: 20rpx 28rpx 0;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.5;
}
.field-list { padding: 20rpx 28rpx 0; }
.field-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}
.field-row:last-child { border-bottom: none; }
.field-label { font-size: 26rpx; color: #64748B; flex-shrink: 0; }
.field-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #0F172A;
  text-align: right;
  margin-left: 20rpx;
}
.field-value.green { color: #059669; }
.field-value.red { color: #DC2626; }
.detail-list { padding: 20rpx 28rpx 0; }
.detail-row {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}
.detail-row:last-child { border-bottom: none; }
.detail-mark {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 18rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-top: 2rpx;
}
.detail-mark.status-success { background: #059669; }
.detail-mark.status-fail { background: #DC2626; }
.detail-info { flex: 1; min-width: 0; }
.detail-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0F172A;
}
.detail-message {
  display: block;
  font-size: 24rpx;
  color: #64748B;
  margin-top: 4rpx;
}
.result-actions {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 28rpx 28rpx;
}
.btn {
  flex: 1;
  height: 72rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-hover { opacity: 0.8; }
.btn-cancel { background: #F1F5F9; color: #64748B; }
.btn-confirm { background: #1677FF; color: #FFFFFF; }
.btn-continue { background: #F1F5F9; color: #475569; }
