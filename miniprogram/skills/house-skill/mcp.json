{
  "apis": [
    {
      "name": "searchHouses",
      "description": "搜索房屋列表（业务对象：房屋结果卡片）。按关键字（地址/编号）和状态筛选房屋，返回匹配的房屋列表。调用前置条件：用户表达查房诉求。【严禁场景】不要用于租客查询、合同查询。",
      "_meta": {
        "ui": {
          "componentPath": "components/house-result/index"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "搜索关键字，匹配地址或编号"
          },
          "status": {
            "type": "string",
            "description": "筛选状态：available/rented/maintenance"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "getHouseDetail",
      "description": "查看单个房屋详情（业务对象：房屋结果卡片）。按房屋 ID 获取房屋基本信息及当前活跃租约。调用前置条件：用户已明确具体房屋。【严禁场景】缺少 houseId 时不要调用。",
      "_meta": {
        "ui": {
          "componentPath": "components/house-result/index"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "houseId": {
            "type": "string",
            "description": "房屋唯一标识"
          }
        },
        "required": [
          "houseId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "getHouseAvailability",
      "description": "查询已出租或未出租房屋；出租状态以活跃合同为准。",
      "_meta": { "ui": { "componentPath": "components/house-result/index" } },
      "inputSchema": { "type": "object", "properties": { "mode": { "type": "string", "enum": ["rented", "available"] } }, "required": ["mode"], "additionalProperties": false },
      "outputSchema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "previewCreateHouse",
      "description": "预览新增房屋并生成确认记录（业务对象：房屋结果卡片）。调用前置条件：用户已提供房屋编号、地址和月租金。【严禁场景】不要直接当成最终新增。",
      "_meta": {
        "ui": {
          "componentPath": "components/house-result/index",
          "pagePath": "/pages/houses/index"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "房屋编号，例如用户说“东楼211”时填 211；不要填完整地址。"
          },
          "address": {
            "type": "string",
            "description": "楼栋地址，仅可填当前页面支持的东楼或里召；用户说“东楼211”时填东楼。"
          },
          "rent": {
            "type": "number",
            "description": "月租金"
          },
          "status": {
            "type": "string",
            "description": "房屋状态，默认 available"
          }
        },
        "required": [
          "code",
          "address",
          "rent"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "confirmCreateHouse",
      "description": "确认新增房屋（业务对象：房屋结果卡片）。调用前置条件：用户已确认新增房屋信息，优先使用确认编号。【严禁场景】不要用于编辑已有房屋。",
      "_meta": {
        "ui": {
          "componentPath": "components/house-result/index"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "confirmationId": {
            "type": "string",
            "description": "预览接口返回的确认编号"
          },
          "code": {
            "type": "string",
            "description": "房屋编号"
          },
          "address": {
            "type": "string",
            "description": "房屋地址"
          },
          "rent": {
            "type": "number",
            "description": "月租金"
          },
          "status": {
            "type": "string",
            "description": "房屋状态，默认 available"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    }
  ],
  "components": [
    {
      "path": "components/house-result/index",
      "relatedPage": "/pages/houses/index"
    }
  ]
}
