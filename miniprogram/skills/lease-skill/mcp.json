{
  "apis": [
    {
      "name": "getActiveLeases",
      "description": "查询所有生效中的租赁合同列表（业务对象：合同结果卡片）。调用前置条件：用户表达查合同/租约诉求。【严禁场景】不要用于房屋或租客查询。",
      "_meta": {
        "ui": {
          "componentPath": "components/lease-result/index"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "搜索关键字，匹配租客姓名或房屋编号"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "previewCreateLease",
      "description": "预览创建合同并生成确认记录（业务对象：合同结果卡片）。调用前置条件：已明确房屋、租客、起租日期和月租金。【严禁场景】不要直接当成最终创建。",
      "_meta": {
        "ui": {
          "componentPath": "components/lease-result/index"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "houseId": {
            "type": "string",
            "description": "房屋 ID"
          },
          "tenantId": {
            "type": "string",
            "description": "租客 ID"
          },
          "startDate": {
            "type": "string",
            "description": "起租日期，YYYY-MM-DD"
          },
          "rent": {
            "type": "number",
            "description": "月租金"
          },
          "deposit": {
            "type": "number",
            "description": "押金"
          },
          "paymentCycle": {
            "type": "string",
            "description": "付款周期：month/quarter/half_year/year"
          },
          "moveInElectricity": {
            "type": "number",
            "description": "入住电表读数"
          },
          "moveInWater": {
            "type": "number",
            "description": "入住水表读数"
          },
          "meterReplaced": {
            "type": "boolean",
            "description": "是否换表"
          },
          "remark": {
            "type": "string",
            "description": "备注"
          }
        },
        "required": [
          "houseId",
          "tenantId",
          "startDate",
          "rent"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
