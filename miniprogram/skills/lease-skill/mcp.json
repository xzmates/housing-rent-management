          },
          "leaseId": {
            "type": "string",
            "description": "合同 ID"
          },
          "dueDate": {
            "type": "string",
            "description": "账单起算日期"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
