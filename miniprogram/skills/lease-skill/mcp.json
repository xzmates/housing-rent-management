          },
          "rent": {
            "type": "number",
            "description": "月租金"
          },
          "deposit": {
            "type": "number",
            "description": "押金"
          },
          "paymentCycle": {
            "type": "string",
            "description": "付款周期"
          },
          "moveInElectricity": {
            "type": "number",
            "description": "入住电表读数"
          },
          "moveInWater": {
            "type": "number",
            "description": "入住水表读数"
          },
          "meterReplaced": {
            "type": "boolean",
            "description": "是否换表"
          },
          "remark": {
            "type": "string",
            "description": "备注"
          }
        },
        "additionalProperties": false
