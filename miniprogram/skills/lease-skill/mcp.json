        "required": [
          "leaseId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "confirmRenewLease",
      "description": "确认生成下一期租金账单（业务对象：合同结果卡片）。调用前置条件：用户已确认续租或提前生成下一期账单。【严禁场景】不要用于退租或实际缴费。",
      "_meta": {
        "ui": {
