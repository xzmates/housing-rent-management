<view class="result-card">
  <view class="result-head">
    <view class="result-mark {{mode}}">
      <text>{{mode === 'confirm' ? '核' : '办'}}</text>
    </view>
    <view class="result-title-block">
      <text class="result-title">{{title}}</text>
      <text class="result-subtitle">{{subtitle}}</text>
    </view>
  </view>

  <view wx:if="{{summary}}" class="result-summary">
    <text>{{summary}}</text>
  </view>

  <view wx:if="{{fields.length > 0}}" class="field-list">
    <view wx:for="{{fields}}" wx:key="label" class="field-row">
      <text class="field-label">{{item.label}}</text>
      <text class="field-value {{item.className || ''}}">{{item.value}}</text>
    </view>
  </view>

  <view wx:elif="{{details.length > 0}}" class="detail-list">
    <view wx:for="{{details}}" wx:key="title" class="detail-row">
      <view class="detail-mark status-{{item.status || 'success'}}">
        <text>{{item.status === 'success' ? '✓' : '✗'}}</text>
      </view>
      <view class="detail-info">
        <text class="detail-title">{{item.title}}</text>
        <text class="detail-message">{{item.message}}</text>
      </view>
    </view>
  </view>

  <view class="result-actions">
    <view class="btn btn-cancel" bindtap="onTapCancel" hover-class="btn-hover">
      <text>{{cancelText}}</text>
    </view>
    <view wx:if="{{mode === 'confirm' && hasConfirm}}" class="btn btn-confirm" bindtap="onTapConfirm" hover-class="btn-hover">
      <text>{{confirmText}}</text>
    </view>
    <view wx:elif="{{mode === 'result'}}" class="btn btn-continue" bindtap="onTapContinue" hover-class="btn-hover">
      <text>继续办理</text>
    </view>
  </view>
</view>
