{
  "apis": [
    {
      "name": "getMoveOutTargets",
      "description": "查询当前可办理退租的有效合同对象（业务对象：退租结果卡片）。调用前置条件：用户表达退租诉求但未明确合同。【严禁场景】不要用于收租或普通抄表。",
      "_meta": {
        "ui": {
          "componentPath": "components/moveout-result/index"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "房屋或租客关键词"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "previewMoveOutSettlement",
      "description": "预览退租结算，计算租金、押金、水电费和应退应补金额，并生成确认记录（业务对象：退租确认卡片）。调用前置条件：已明确合同、退租日期和退租水电读数。【严禁场景】不要直接替代最终退租。",
      "_meta": {
        "ui": {
          "componentPath": "components/moveout-result/index"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "leaseId": {
            "type": "string",
            "description": "合同 ID"
          },
          "moveOutDate": {
            "type": "string",
            "description": "退租日期"
          },
          "electricityReading": {
            "type": "number",
            "description": "退租电表读数"
          },
          "waterReading": {
            "type": "number",
            "description": "退租水表读数"
          },
          "damageAmount": {
            "type": "number",
            "description": "赔偿或扣款金额"
          },
          "remark": {
            "type": "string",
            "description": "备注"
          }
        },
        "required": [
          "leaseId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "settleMoveOut",
      "description": "确认办理退租，执行结算并更新合同、账单、付款记录、房屋和租客状态（业务对象：退租结果卡片）。调用前置条件：用户已确认退租结算，优先使用确认编号。【严禁场景】不要用于普通合同创建。",
      "_meta": {
        "ui": {
          "componentPath": "components/moveout-result/index"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "confirmationId": {
            "type": "string",
            "description": "预览接口返回的确认编号"
          },
          "leaseId": {
            "type": "string",
            "description": "合同 ID"
          },
          "moveOutDate": {
            "type": "string",
            "description": "退租日期"
          },
          "endDate": {
            "type": "string",
            "description": "退租日期"
          },
          "electricityReading": {
            "type": "number",
            "description": "退租电表读数"
          },
          "waterReading": {
            "type": "number",
            "description": "退租水表读数"
          },
          "damageAmount": {
            "type": "number",
            "description": "赔偿或扣款金额"
          },
          "remark": {
            "type": "string",
            "description": "备注"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    }
  ],
  "components": [
    {
      "path": "components/moveout-result/index",
      "relatedPage": "/pages/tenants/index"
    }
  ]
}
