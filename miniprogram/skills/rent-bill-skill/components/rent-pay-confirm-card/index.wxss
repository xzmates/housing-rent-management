/* ratio=4:3
 * 色源：app.json window.backgroundColor #EEF7FF + tabBar.selectedColor #1677FF；
 * pages/payments 使用 #F8FBFF 卡片、#EF5350 金额、#6B7280 次要文字。
 * 暗黑：浅蓝底 #EEF7FF 降明度推导 #111927，描边 #2F3A4D。
 */
.confirm-card {
  display: flex;
  flex-direction: column;
  padding: 3.2vw;
  background-color: #F8FBFF;
  border-width: 1rpx;
  border-style: solid;
  border-color: #D7E6FA;
  border-radius: 1.07vw;
  box-shadow: 0 2vw 5.4vw rgba(30, 79, 140, 0.10);
  box-sizing: border-box;
  overflow: hidden;
}

.confirm-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 3.2vw;
}

.confirm-title {
  font-size: 4.53vw;
  line-height: 1.2;
  font-weight: 600;
  color: rgba(17, 24, 39, 0.9);
}

.confirm-sub {
  padding: 0.8vw 1.6vw;
  border-radius: 1.07vw;
  background-color: #EAF3FF;
  color: #1677FF;
  font-size: 3.2vw;
  line-height: 1.2;
  font-weight: 600;
}

.confirm-amount {
  background-color: #FFFFFF;
  border-width: 1rpx;
  border-style: solid;
  border-color: #E1ECFA;
  border-radius: 1.07vw;
  padding: 3.2vw;
  margin-bottom: 3.2vw;
}

.amount-label {
  display: block;
  font-size: 3.2vw;
  line-height: 1.3;
  color: rgba(17, 24, 39, 0.45);
}

.amount-value {
  display: block;
  margin-top: 1.07vw;
  font-size: 8.4vw;
  line-height: 1;
  font-weight: 600;
  color: #EF5350;
}

.confirm-lines {
  border-top-width: 1rpx;
  border-top-style: solid;
  border-top-color: rgba(148, 163, 184, 0.22);
}

.confirm-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 1.6vw 0;
  border-bottom-width: 1rpx;
  border-bottom-style: solid;
  border-bottom-color: rgba(148, 163, 184, 0.18);
}

.line-label {
  flex-shrink: 0;
  font-size: 3.2vw;
  color: rgba(17, 24, 39, 0.45);
}

.line-value {
  margin-left: 2.13vw;
  flex: 1;
  text-align: right;
  font-size: 4vw;
  color: rgba(17, 24, 39, 0.9);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.confirm-summary {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 2.13vw;
  font-size: 3.2vw;
  line-height: 1.3;
  color: rgba(17, 24, 39, 0.45);
}

.confirm-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 3.2vw;
}

.secondary-btn,
.primary-btn {
  flex: 1;
  height: 10.67vw;
  line-height: 10.67vw;
  border-radius: 1.07vw;
  text-align: center;
  font-size: 4vw;
  font-weight: 600;
}

.secondary-btn {
  margin-right: 2.13vw;
  background-color: #EEF2F7;
  color: rgba(17, 24, 39, 0.45);
}

.primary-btn {
  background-color: #1677FF;
  color: #FFFFFF;
}

.secondary-btn-hover,
.primary-btn-hover {
  opacity: 0.86;
}

@media (prefers-color-scheme: dark) {
  .confirm-card {
    background-color: #111927;
    border-color: #2F3A4D;
    box-shadow: none;
  }
  .confirm-title,
  .line-value {
    color: rgba(255, 255, 255, 0.9);
  }
  .amount-label,
  .line-label,
  .confirm-summary {
    color: rgba(255, 255, 255, 0.45);
  }
  .confirm-sub {
    background-color: #172C4A;
  }
  .confirm-amount {
    background-color: #152033;
    border-color: #2F3A4D;
  }
  .confirm-lines,
  .confirm-line {
    border-color: rgba(255, 255, 255, 0.12);
  }
  .secondary-btn {
    background-color: #202B3C;
    color: rgba(255, 255, 255, 0.45);
  }
}
