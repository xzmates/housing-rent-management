<view class="result-card">
  <view class="result-status">
    <view class="status-mark">
      <text>收</text>
    </view>
    <text class="result-title">收租成功</text>
    <text class="result-sub">{{houseLabel}} · {{tenantName}}</text>
  </view>

  <view class="result-amount">
    <text class="amount-label">本次实收</text>
    <text class="amount-value">¥{{paymentAmount}}</text>
  </view>

  <view class="result-lines">
    <view class="result-line">
      <text class="line-label">账期</text>
      <text class="line-value">{{period || '本期租金'}}</text>
    </view>
    <view class="result-line">
      <text class="line-label">方式</text>
      <text class="line-value">{{paymentMethodText}} · {{paymentDate}}</text>
    </view>
    <view class="result-line">
      <text class="line-label">累计</text>
      <text class="line-value">已收 ¥{{totalPaid}} / 应收 ¥{{totalAmount}}</text>
    </view>
    <view class="result-line">
      <text class="line-label">状态</text>
      <text class="line-value">{{statusText}}，剩余 ¥{{remaining}}</text>
    </view>
  </view>

  <view class="result-actions">
    <view class="secondary-btn" hover-class="secondary-btn-hover" bindtap="onTapHistory">
      <text>查看记录</text>
    </view>
    <view class="primary-btn" hover-class="primary-btn-hover" bindtap="onTapBills">
      <text>继续收租</text>
    </view>
  </view>
</view>
