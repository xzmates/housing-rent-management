/* ratio=4:3
 * 色源：app.json window.backgroundColor #EEF7FF + tabBar.selectedColor #1677FF；
 * app.wxss 提供成功色 #18A66A、金额色 #EF5350、文字 #111827。
 * 暗黑：浅蓝底 #EEF7FF 降明度推导 #111927，描边 #2F3A4D。
 */
.result-card {
  display: flex;
  flex-direction: column;
  padding: 3.2vw;
  background-color: #F8FBFF;
  border-width: 1rpx;
  border-style: solid;
  border-color: #D7E6FA;
  border-radius: 1.07vw;
  box-shadow: 0 2vw 5.4vw rgba(30, 79, 140, 0.10);
  box-sizing: border-box;
  overflow: hidden;
}

.result-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 3.2vw;
}

.status-mark {
  width: 12.8vw;
  height: 12.8vw;
  border-radius: 1.07vw;
  background-color: #E9F8F1;
  color: #18A66A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 4.53vw;
  font-weight: 600;
  margin-bottom: 2.13vw;
}

.result-title {
  font-size: 4.53vw;
  line-height: 1.2;
  font-weight: 600;
  color: rgba(17, 24, 39, 0.9);
}

.result-sub {
  margin-top: 1.07vw;
  max-width: 100%;
  font-size: 3.2vw;
  line-height: 1.3;
  color: rgba(17, 24, 39, 0.45);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.result-amount {
  text-align: center;
  margin-bottom: 3.2vw;
}

.amount-label {
  display: block;
  font-size: 3.2vw;
  color: rgba(17, 24, 39, 0.45);
}

.amount-value {
  display: block;
  margin-top: 1.07vw;
  font-size: 8.4vw;
  line-height: 1;
  font-weight: 600;
  color: #EF5350;
}

.result-lines {
  border-top-width: 1rpx;
  border-top-style: solid;
  border-top-color: rgba(148, 163, 184, 0.22);
}

.result-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 1.6vw 0;
  border-bottom-width: 1rpx;
  border-bottom-style: solid;
  border-bottom-color: rgba(148, 163, 184, 0.18);
}

.line-label {
  flex-shrink: 0;
  font-size: 3.2vw;
  color: rgba(17, 24, 39, 0.45);
}

.line-value {
  flex: 1;
  margin-left: 2.13vw;
  text-align: right;
  font-size: 4vw;
  color: rgba(17, 24, 39, 0.9);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.result-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 3.2vw;
}

.secondary-btn,
.primary-btn {
  flex: 1;
  height: 10.67vw;
  line-height: 10.67vw;
  border-radius: 1.07vw;
  text-align: center;
  font-size: 4vw;
  font-weight: 600;
}

.secondary-btn {
  margin-right: 2.13vw;
  background-color: #EEF2F7;
  color: rgba(17, 24, 39, 0.45);
}

.primary-btn {
  background-color: #1677FF;
  color: #FFFFFF;
}

.secondary-btn-hover,
.primary-btn-hover {
  opacity: 0.86;
}

@media (prefers-color-scheme: dark) {
  .result-card {
    background-color: #111927;
    border-color: #2F3A4D;
    box-shadow: none;
  }
  .result-title,
  .line-value {
    color: rgba(255, 255, 255, 0.9);
  }
  .result-sub,
  .amount-label,
  .line-label {
    color: rgba(255, 255, 255, 0.45);
  }
  .status-mark {
    background-color: #153126;
  }
  .result-lines,
  .result-line {
    border-color: rgba(255, 255, 255, 0.12);
  }
  .secondary-btn {
    background-color: #202B3C;
    color: rgba(255, 255, 255, 0.45);
  }
}
