/* ratio=4:5
 * 色源：app.json #EEF7FF/#1677FF，业务主文字 #111827，辅助 #6B7280。
 * 暗黑：浅蓝底降明度为 #111927，描边 #2F3A4D。
 */
.assistant-card {
  display: flex;
  flex-direction: column;
  padding: 3.2vw;
  background-color: #F8FBFF;
  border-width: 1rpx;
  border-style: solid;
  border-color: #D7E6FA;
  border-radius: 1.07vw;
  box-sizing: border-box;
  overflow: hidden;
}

.assistant-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 2.13vw;
}

.assistant-accent {
  width: 1.6vw;
  height: 8.53vw;
  border-radius: 0.8vw;
  background-color: #1677FF;
  margin-right: 2.13vw;
}

.assistant-title-block {
  min-width: 0;
  flex: 1;
}

.assistant-title {
  display: block;
  font-size: 4.8vw;
  line-height: 1.2;
  font-weight: 600;
  color: rgba(17, 24, 39, 0.92);
}

.assistant-sub {
  display: block;
  margin-top: 1.07vw;
  font-size: 3.2vw;
  line-height: 1.25;
  color: rgba(17, 24, 39, 0.45);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.assistant-question {
  display: block;
  margin-bottom: 2.13vw;
  font-size: 4vw;
  line-height: 1.2;
  font-weight: 600;
  color: rgba(17, 24, 39, 0.9);
}

.assistant-list {
  flex: 1;
  overflow: hidden;
}

.assistant-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 2.13vw;
  margin-bottom: 1.6vw;
  background-color: #FFFFFF;
  border-width: 1rpx;
  border-style: solid;
  border-color: rgba(215, 230, 250, 0.9);
  border-radius: 1.07vw;
  box-sizing: border-box;
}

.assistant-row-hover {
  opacity: 0.86;
}

.assistant-index {
  width: 8.53vw;
  height: 8.53vw;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 1.07vw;
  background-color: #17324F;
  color: #FFFFFF;
  font-size: 3.47vw;
  font-weight: 600;
  margin-right: 2.13vw;
}

.assistant-info {
  flex: 1;
  min-width: 0;
}

.assistant-name {
  display: block;
  font-size: 4vw;
  line-height: 1.25;
  font-weight: 600;
  color: rgba(17, 24, 39, 0.9);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.assistant-desc {
  display: block;
  margin-top: 0.8vw;
  font-size: 3.2vw;
  line-height: 1.25;
  color: rgba(17, 24, 39, 0.45);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.assistant-arrow {
  flex-shrink: 0;
  margin-left: 2.13vw;
  font-size: 6.4vw;
  line-height: 1;
  color: #AAB7C7;
}

@media (prefers-color-scheme: dark) {
  .assistant-card {
    background-color: #111927;
    border-color: #2F3A4D;
  }
  .assistant-row {
    background-color: #182235;
    border-color: #2F3A4D;
  }
  .assistant-title,
  .assistant-question,
  .assistant-name {
    color: rgba(255, 255, 255, 0.9);
  }
  .assistant-sub,
  .assistant-desc {
    color: rgba(255, 255, 255, 0.45);
  }
}
