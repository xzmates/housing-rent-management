<view class="result-card" data-success="{{success}}" data-failed="{{failed}}" data-preview-key="{{previewKey}}">
  <view class="result-head">
    <view class="result-mark">
      <text>{{mode === 'confirm' ? '核' : '办'}}</text>
    </view>
    <view class="result-title-block">
      <text class="result-title">{{actionTitle}}</text>
      <text class="result-sub">{{statusText}} · {{mode === 'confirm' ? '等待确认' : ('成功 ' + success + ' 项')}}</text>
    </view>
  </view>

  <view class="result-summary">
    <text>{{summary}}</text>
  </view>

  <view wx:if="{{mode === 'confirm' && hasMoveOutPreview}}" class="moveout-panel">
    <view class="moveout-notice">
      <text>租客 </text>
      <text class="notice-strong">{{moveOutPreview.tenantName}}</text>
      <text> 将从 {{moveOutPreview.houseText}} 退租</text>
    </view>

    <view class="field-list moveout-fields">
      <view class="field-row">
        <text class="field-label wide">退租日期</text>
        <text class="field-value">{{moveOutPreview.moveOutDate}}</text>
      </view>
      <view class="field-row">
        <text class="field-label wide">房屋损失费</text>
        <text class="field-value">¥{{moveOutPreview.damageAmount}}</text>
      </view>
      <view class="field-row">
        <text class="field-label wide">退租电表</text>
        <text class="field-value">{{moveOutPreview.moveOutElectricity}}（上次 {{moveOutPreview.lastElectricity}}）</text>
      </view>
      <view class="field-row">
        <text class="field-label wide">退租水表</text>
        <text class="field-value">{{moveOutPreview.moveOutWater}}（上次 {{moveOutPreview.lastWater}}）</text>
      </view>
    </view>

    <view class="{{moveOutPreview.outstandingAmount > 0 ? 'moveout-warning' : 'moveout-ok'}}">
      <text>{{moveOutPreview.canMoveOutText}}</text>
    </view>

    <view class="settlement-box compact-box">
      <view class="settlement-row">
        <text>水电用量</text>
        <text>{{moveOutPreview.utilityUsageText}}</text>
      </view>
      <view class="settlement-row">
        <text>本次水电费</text>
        <text>¥{{moveOutPreview.utilityCost}}</text>
      </view>
      <view class="settlement-row final-row">
        <text>{{moveOutPreview.finalLabel}}</text>
        <text class="{{moveOutPreview.totalRefund >= 0 ? 'green-text' : 'danger-text'}}">¥{{moveOutPreview.finalAmount}}</text>
      </view>
    </view>

    <view class="detail-btn" hover-class="secondary-btn-hover" bindtap="onTapDetail">
      <text>查看完整结算</text>
    </view>
  </view>

  <view wx:elif="{{mode === 'confirm' && fields.length > 0}}" class="field-list">
    <view wx:for="{{fields}}" wx:key="label" class="field-row">
      <text class="field-label">{{item.label}}</text>
      <text class="field-value">{{item.value}}</text>
    </view>
  </view>

  <view wx:if="{{mode !== 'confirm' && details.length > 0}}" class="result-list">
    <view wx:for="{{details}}" wx:key="id" class="result-row">
      <view class="row-mark">
        <text>成</text>
      </view>
      <view class="row-info">
        <text class="row-title">{{item.title}}</text>
        <text class="row-message">{{item.message}}</text>
      </view>
    </view>
  </view>

  <view class="result-actions">
    <view class="secondary-btn" hover-class="secondary-btn-hover" bindtap="onTapMenu">
      <text>{{mode === 'confirm' ? '取消' : '继续办理'}}</text>
    </view>
    <view
      wx:if="{{mode === 'confirm'}}"
      class="primary-btn"
      hover-class="primary-btn-hover"
      bindtap="onTapConfirm"
      data-action-name="{{actionName}}"
      data-confirm-token="{{confirmToken}}"
    >
      <text>{{hasMoveOutPreview ? '确认退租' : '确认办理'}}</text>
    </view>
  </view>
</view>
